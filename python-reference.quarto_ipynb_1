      "cell_type": "code",
      "metadata": {},
      "source": [
        "def softmax(z):\n",
        "    z = np.asarray(z, dtype=float)\n",
        "    z = z - np.max(z)\n",
        "    exp_z = np.exp(z)\n",
        "    return exp_z / exp_z.sum()"
