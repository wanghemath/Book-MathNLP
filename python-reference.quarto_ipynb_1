        "## Cosine similarity"
      ],
      "id": "146929c0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def cosine_similarity(x, y):\n",
        "    x = np.asarray(x, dtype=float)\n",
        "    y = np.asarray(y, dtype=float)\n",
        "    denom = np.linalg.norm(x) * np.linalg.norm(y)\n",
        "    if denom == 0:\n",
        "        return 0.0\n",
        "    return float(np.dot(x, y) / denom)"
      ],
