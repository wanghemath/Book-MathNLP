        "#| label: ch01-count-vectors\n",
        "#| echo: true\n",
        "\n",
        "corpus = [\n",
        "    \"machine learning models learn from data\",\n",
        "    \"language models predict the next token\",\n",
        "    \"statistics studies data uncertainty and models\",\n",
        "]\n",
        "\n",
        "tokenized = [doc.split() for doc in corpus]\n",
        "vocab = sorted(set(token for doc in tokenized for token in doc))\n",
        "\n",
        "count_vectors = []\n",
        "for doc in tokenized:\n",
        "    count_vectors.append([doc.count(token) for token in vocab])\n",
        "\n",
        "print(\"Vocabulary size:\", len(vocab))\n",
        "print(\"Vocabulary:\", vocab)\n",
        "print(\"Count vectors:\")\n",
        "for vector in count_vectors:\n",
        "    print(vector)"
