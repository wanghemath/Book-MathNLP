      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "\n",
        "\n",
        "def sinusoidal_encoding(T, d, scale=10000.0):\n",
        "    \"\"\"Return a T by d matrix of sinusoidal positional encodings.\"\"\"\n",
        "    if d % 2 != 0:\n",
        "        raise ValueError(\"d must be even for paired sine/cosine coordinates.\")\n",
        "    positions = np.arange(T)[:, None]\n",
        "    pair_ids = np.arange(d // 2)[None, :]\n",
        "    denominators = scale ** (2 * pair_ids / d)\n",
        "    angles = positions / denominators\n",
        "\n",
        "    P = np.zeros((T, d))\n",
        "    P[:, 0::2] = np.sin(angles)\n",
        "    P[:, 1::2] = np.cos(angles)\n",
        "    return P\n",
        "\n",
        "P = sinusoidal_encoding(T=8, d=6)\n",
        "print(P.shape)\n",
        "print(np.round(P[:3], 3))"
