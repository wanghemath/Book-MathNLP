    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def row_softmax(S):\n",
        "    S_shifted = S - S.max(axis=1, keepdims=True)\n",
        "    E = np.exp(S_shifted)\n",
        "    return E / E.sum(axis=1, keepdims=True)\n",
        "\n",
        "\n",
        "def self_attention_no_position(X, Wq, Wk, Wv):\n",
        "    Q = X @ Wq\n",
        "    K = X @ Wk\n",
        "    V = X @ Wv\n",
        "    S = Q @ K.T / np.sqrt(Q.shape[1])\n",
        "    A = row_softmax(S)\n",
        "    return A @ V\n",
        "\n",
        "rng = np.random.default_rng(16)\n",
        "T, d, dk, dv = 5, 4, 3, 3\n",
        "X = rng.normal(size=(T, d))\n",
        "Wq = rng.normal(size=(d, dk))\n",
        "Wk = rng.normal(size=(d, dk))\n",
        "Wv = rng.normal(size=(d, dv))\n",
        "\n",
        "perm = np.array([2, 0, 4, 1, 3])\n",
        "Pmat = np.eye(T)[perm]\n",
        "\n",
        "Y = self_attention_no_position(X, Wq, Wk, Wv)\n",
        "Y_perm = self_attention_no_position(Pmat @ X, Wq, Wk, Wv)\n",
        "\n",
        "print(np.allclose(Y_perm, Pmat @ Y))"
      ],
