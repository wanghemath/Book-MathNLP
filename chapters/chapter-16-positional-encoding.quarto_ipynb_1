    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def apply_rope(X, scale=10000.0):\n",
        "    \"\"\"Apply rotary position rotations to a T by d matrix X with even d.\"\"\"\n",
        "    T, d = X.shape\n",
        "    if d % 2 != 0:\n",
        "        raise ValueError(\"d must be even for pairwise rotations.\")\n",
        "    positions = np.arange(T)[:, None]\n",
        "    pair_ids = np.arange(d // 2)[None, :]\n",
        "    omega = scale ** (-2 * pair_ids / d)\n",
        "    theta = positions * omega\n",
        "\n",
        "    cos = np.cos(theta)\n",
        "    sin = np.sin(theta)\n",
        "\n",
        "    X_even = X[:, 0::2]\n",
        "    X_odd = X[:, 1::2]\n",
        "\n",
        "    Y = np.empty_like(X)\n",
        "    Y[:, 0::2] = X_even * cos - X_odd * sin\n",
        "    Y[:, 1::2] = X_even * sin + X_odd * cos\n",
        "    return Y\n",
        "\n",
        "Q = rng.normal(size=(6, 8))\n",
        "K = rng.normal(size=(6, 8))\n",
        "\n",
        "Q_rot = apply_rope(Q)\n",
        "K_rot = apply_rope(K)\n",
        "S_rot = Q_rot @ K_rot.T / np.sqrt(Q.shape[1])\n",
        "\n",
        "print(S_rot.shape)\n",
        "print(np.round(S_rot[:2, :4], 3))"
      ],
