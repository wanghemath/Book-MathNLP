        "#| label: py-ch02-simple-tokenizer\n",
        "#| echo: true\n",
        "#| warning: false\n",
        "\n",
        "import re\n",
        "from collections import Counter\n",
        "\n",
        "corpus = [\n",
        "    \"Data models learn from data.\",\n",
        "    \"Language models predict the next token.\",\n",
        "    \"Statistics studies data, uncertainty, and models.\"\n",
        "]\n",
        "\n",
        "def normalize(text):\n",
        "    \"\"\"Lowercase and keep alphabetic tokens only.\"\"\"\n",
        "    text = text.lower()\n",
        "    text = re.sub(r\"[^a-z\\s]\", \" \", text)\n",
        "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
        "    return text\n",
        "\n",
        "def word_tokenize(text):\n",
        "    return normalize(text).split()\n",
        "\n",
        "tokenized = [word_tokenize(doc) for doc in corpus]\n",
        "tokenized"
      ],
      "id": "py-ch02-simple-tokenizer",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: py-ch02-vocabulary\n",
        "#| echo: true\n",
        "\n",
        "all_tokens = [token for doc in tokenized for token in doc]\n",
        "counts = Counter(all_tokens)\n",
        "\n",
        "vocab = sorted(counts)\n",
        "token_to_id = {token: j for j, token in enumerate(vocab)}\n",
        "id_to_token = {j: token for token, j in token_to_id.items()}\n",
        "\n",
        "print(\"Vocabulary size:\", len(vocab))\n",
        "print(token_to_id)"
      ],
      "id": "py-ch02-vocabulary",
      "execution_count": null,
      "outputs": []
