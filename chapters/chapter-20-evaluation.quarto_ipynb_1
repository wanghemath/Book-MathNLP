        "def evaluation_report(y_true, p_score, threshold=0.5, bins=5):\n",
        "    base = binary_metrics(y_true, p_score, threshold)\n",
        "    rows, ece = calibration_table(y_true, p_score, bins=bins)\n",
        "    brier = float(np.mean((p_score - y_true) ** 2))\n",
        "    return {\n",
        "        **base,\n",
        "        \"ECE\": ece,\n",
        "        \"Brier\": brier,\n",
        "        \"calibration_bins\": rows,\n",
        "    }\n",
        "\n",
        "report = evaluation_report(y_true, p_score, threshold=0.5, bins=5)\n",
        "for key, value in report.items():\n",
        "    print(key, \":\", value)"
