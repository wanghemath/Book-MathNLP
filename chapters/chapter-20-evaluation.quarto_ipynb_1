        "from collections import Counter\n",
        "import math\n",
        "\n",
        "def tokenize_simple(text):\n",
        "    return text.lower().replace(\".\", \"\").replace(\",\", \"\").split()\n",
        "\n",
        "def ngrams(tokens, n):\n",
        "    return [tuple(tokens[i:i+n]) for i in range(len(tokens) - n + 1)]\n",
        "\n",
        "def clipped_precision(generated, reference, n):\n",
        "    g_counts = Counter(ngrams(generated, n))\n",
        "    r_counts = Counter(ngrams(reference, n))\n",
        "    overlap = sum(min(count, r_counts[gram]) for gram, count in g_counts.items())\n",
        "    total = sum(g_counts.values())\n",
        "    return overlap / total if total > 0 else 0.0\n",
        "\n",
        "def rouge1_recall(generated, reference):\n",
        "    g_counts = Counter(generated)\n",
        "    r_counts = Counter(reference)\n",
        "    overlap = sum(min(g_counts[token], count) for token, count in r_counts.items())\n",
        "    total = sum(r_counts.values())\n",
        "    return overlap / total if total > 0 else 0.0\n",
        "\n",
        "def bleu_like(generated, reference, max_n=2, eps=1e-12):\n",
        "    precisions = [max(clipped_precision(generated, reference, n), eps) for n in range(1, max_n + 1)]\n",
        "    geo = math.exp(sum(math.log(p) for p in precisions) / max_n)\n",
        "    bp = 1.0 if len(generated) > len(reference) else math.exp(1 - len(reference) / max(len(generated), 1))\n",
        "    return bp * geo\n",
        "\n",
