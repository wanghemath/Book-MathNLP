        "macro_f1 = np.mean([row[-1] for row in rows])\n",
        "weighted_f1 = sum(row[1] * row[-1] for row in rows) / len(y_true_mc)\n",
        "accuracy = np.mean(y_true_mc == y_pred_mc)\n",
        "print(\"macro F1:\", macro_f1)\n",
