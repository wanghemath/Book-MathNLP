        "print(\"clipped bigram precision:\", clipped_precision(generated, reference, 2))\n",
        "print(\"ROUGE-1 recall:\", rouge1_recall(generated, reference))\n",
        "print(\"BLEU-like score:\", bleu_like(generated, reference, max_n=2))"
