        "\n",
        "## 13.12 Python: causal mask\n",
        "\n",
        "A causal mask prevents position $i$ from using information at future positions $j>i$."
      ],
      "id": "b6cac64d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: py-ch13-causal-mask\n",
        "#| echo: true\n",
        "\n",
        "T = 5\n",
        "causal_mask = np.triu(np.ones((T, T)), k=1)\n",
        "causal_mask = np.where(causal_mask == 1, -1e9, 0.0)\n",
        "\n",
        "Z_causal, A_causal, scores_causal = attention(Q, K, V, mask=causal_mask)\n",
        "\n",
        "pd.DataFrame(A_causal, columns=[f\"key {j}\" for j in range(T)],\n",
        "             index=[f\"query {i}\" for i in range(T)])"
