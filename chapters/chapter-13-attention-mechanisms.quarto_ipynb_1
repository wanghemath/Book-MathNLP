        "  function stableSoftmax(row) {\n",
        "    const maxVal = Math.max.apply(null, row);\n",
        "    const expVals = row.map(v => Math.exp(v - maxVal));\n",
        "    const total = expVals.reduce((a, b) => a + b, 0);\n",
        "    return expVals.map(v => v / total);\n",
        "  }\n",
        "\n",
        "  function matMul(A, B) {\n",
        "    const rows = A.length;\n",
        "    const cols = B[0].length;\n",
        "    const inner = B.length;\n",
        "    const C = [];\n",
        "    for (let i = 0; i < rows; i++) {\n",
        "      const row = [];\n",
        "      for (let j = 0; j < cols; j++) {\n",
        "        let total = 0;\n",
        "        for (let k = 0; k < inner; k++) total += A[i][k] * B[k][j];\n",
        "        row.push(total);\n",
        "      }\n",
        "      C.push(row);\n",
        "    }\n",
        "    return C;\n",
        "  }\n",
        "\n",
        "  function transpose(A) {\n",
        "    return A[0].map((_, j) => A.map(row => row[j]));\n",
