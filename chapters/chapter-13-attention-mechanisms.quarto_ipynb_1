        "## 13.11 Python: attention with learned projections\n",
        "\n",
        "In a neural network, $Q$, $K$, and $V$ are usually obtained from an input matrix $X$ by learned linear maps."
      ],
      "id": "828bda75"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: py-ch13-projections\n",
        "#| echo: true\n",
        "\n",
        "rng = np.random.default_rng(7243)\n",
        "\n",
        "T = 5\n",
        "D_model = 4\n",
        "d_k = 3\n",
        "d_v = 2\n",
        "\n",
        "X = rng.normal(size=(T, D_model))\n",
        "W_Q = rng.normal(scale=0.3, size=(D_model, d_k))\n",
        "W_K = rng.normal(scale=0.3, size=(D_model, d_k))\n",
        "W_V = rng.normal(scale=0.3, size=(D_model, d_v))\n",
        "\n",
        "Q = X @ W_Q\n",
        "K = X @ W_K\n",
        "V = X @ W_V\n",
        "\n",
        "Z, A, scores = attention(Q, K, V)\n",
        "\n",
        "print(\"X shape:\", X.shape)\n",
        "print(\"Q shape:\", Q.shape)\n",
        "print(\"K shape:\", K.shape)\n",
        "print(\"V shape:\", V.shape)\n",
        "print(\"A shape:\", A.shape)\n",
        "print(\"Z shape:\", Z.shape)"
      ],
      "id": "py-ch13-projections",
      "execution_count": null,
      "outputs": []
    },
