      "source": [
        "def tfidf_transform(X):\n",
        "    n = X.shape[0]\n",
        "    df = np.sum(X > 0, axis=0)\n",
        "    idf = np.log((1 + n) / (1 + df)) + 1\n",
        "    return X * idf, idf\n",
        "\n",
        "X_tfidf, idf = tfidf_transform(X_counts)\n",
        "\n",
        "idf_table = pd.DataFrame({\"term\": vocab, \"idf\": idf}).sort_values(\"idf\", ascending=False)\n",
        "idf_table.head(12)"
