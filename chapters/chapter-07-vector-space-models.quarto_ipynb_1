        "# Work with the TF-IDF matrix for SVD.\n",
        "X = X_tfidf.copy()\n",
        "\n",
        "U, singular_values, Vt = np.linalg.svd(X, full_matrices=False)\n",
        "\n",
        "sv_table = pd.DataFrame({\n",
        "    \"component\": np.arange(1, len(singular_values) + 1),\n",
        "    \"singular_value\": singular_values,\n",
        "    \"energy_fraction\": singular_values**2 / np.sum(singular_values**2),\n",
        "    \"cumulative_energy\": np.cumsum(singular_values**2) / np.sum(singular_values**2)\n",
        "})\n",
        "sv_table"
      ],
