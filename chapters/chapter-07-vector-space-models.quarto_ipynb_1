      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The squared singular values describe how much Frobenius-norm energy is captured by each component."
      ],
      "id": "21416087"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def truncated_svd_coordinates(X, k):\n",
        "    U, s, Vt = np.linalg.svd(X, full_matrices=False)\n",
        "    Uk = U[:, :k]\n",
        "    sk = s[:k]\n",
        "    Vtk = Vt[:k, :]\n",
        "    Z_docs = Uk * sk\n",
        "    return Z_docs, Vtk.T, sk\n",
        "\n",
        "Z2, V2, s2 = truncated_svd_coordinates(X, k=2)\n",
        "\n",
        "coords = pd.DataFrame({\n",
        "    \"doc\": [f\"d{i+1}\" for i in range(len(corpus))],\n",
        "    \"x\": Z2[:, 0],\n",
        "    \"y\": Z2[:, 1],\n",
        "    \"label\": labels,\n",
        "    \"text\": corpus\n",
        "})\n",
        "coords"
      ],
