      "source": [
        "## Reconstruction error\n",
        "\n",
        "A rank-$k$ approximation is useful only if it captures enough structure.  The following code computes reconstruction error for each possible $k$."
      ],
      "id": "207c1fe8"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def svd_reconstruction(X, k):\n",
        "    U, s, Vt = np.linalg.svd(X, full_matrices=False)\n",
        "    return (U[:, :k] * s[:k]) @ Vt[:k, :]\n",
        "\n",
        "rows = []\n",
        "for k in range(1, min(X.shape) + 1):\n",
        "    Xk = svd_reconstruction(X, k)\n",
        "    error = np.linalg.norm(X - Xk, ord=\"fro\")\n",
        "    relative_error = error / np.linalg.norm(X, ord=\"fro\")\n",
        "    rows.append((k, error, relative_error))\n",
        "\n",
        "pd.DataFrame(rows, columns=[\"k\", \"frobenius_error\", \"relative_error\"])"
