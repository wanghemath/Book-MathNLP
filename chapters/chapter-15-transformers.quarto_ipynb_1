        "        total += dff + d    # FFN biases\n",
        "    return {\n",
        "        \"attention_weights\": attention,\n",
        "        \"feedforward_weights\": feedforward,\n",
        "        \"layernorm_parameters\": layernorm,\n",
        "        \"total\": total,\n",
        "    }\n",
