        "\n",
        "X = rng.normal(size=(T, d))\n",
        "\n",
        "params = {\n",
        "    \"WQ\": rng.normal(scale=0.2, size=(h, d, dh)),\n",
        "    \"WK\": rng.normal(scale=0.2, size=(h, d, dh)),\n",
        "    \"WV\": rng.normal(scale=0.2, size=(h, d, dh)),\n",
        "    \"WO\": rng.normal(scale=0.2, size=(h * dh, d)),\n",
        "    \"W1\": rng.normal(scale=0.2, size=(d, dff)),\n",
        "    \"b1\": np.zeros(dff),\n",
        "    \"W2\": rng.normal(scale=0.2, size=(dff, d)),\n",
        "    \"b2\": np.zeros(d),\n",
        "}\n",
        "\n",
        "def relu(U):\n",
        "    return np.maximum(U, 0.0)\n",
