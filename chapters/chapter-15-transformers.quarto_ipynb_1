      "source": [
        "#| label: py-ch15-mha-from-scratch\n",
        "#| echo: true\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(7243)\n",
        "\n",
        "T = 5\n",
        "model_dim = 8\n",
        "num_heads = 2\n",
        "head_dim = model_dim // num_heads\n",
        "\n",
        "X = rng.normal(size=(T, model_dim))\n",
        "\n",
        "WQ = rng.normal(scale=0.2, size=(num_heads, model_dim, head_dim))\n",
        "WK = rng.normal(scale=0.2, size=(num_heads, model_dim, head_dim))\n",
        "WV = rng.normal(scale=0.2, size=(num_heads, model_dim, head_dim))\n",
        "WO = rng.normal(scale=0.2, size=(num_heads * head_dim, model_dim))\n",
        "\n",
        "def softmax_rows(S):\n",
        "    S_shift = S - S.max(axis=1, keepdims=True)\n",
        "    E = np.exp(S_shift)\n",
        "    return E / E.sum(axis=1, keepdims=True)\n",
        "\n",
        "def multi_head_attention(X, WQ, WK, WV, WO, mask=None):\n",
        "    head_outputs = []\n",
        "    attention_matrices = []\n",
        "    for r in range(WQ.shape[0]):\n",
        "        Q = X @ WQ[r]\n",
        "        K = X @ WK[r]\n",
        "        V = X @ WV[r]\n",
        "        scores = (Q @ K.T) / np.sqrt(Q.shape[1])\n",
        "        if mask is not None:\n",
        "            scores = scores + mask\n",
        "        A = softmax_rows(scores)\n",
        "        Z = A @ V\n",
        "        head_outputs.append(Z)\n",
        "        attention_matrices.append(A)\n",
        "    Z_all = np.concatenate(head_outputs, axis=1)\n",
        "    return Z_all @ WO, attention_matrices\n",
        "\n",
        "Y, As = multi_head_attention(X, WQ, WK, WV, WO)\n",
        "\n",
        "print(\"X shape:\", X.shape)\n",
        "print(\"head attention shape:\", As[0].shape)\n",
        "print(\"output shape:\", Y.shape)\n",
        "print(\"row sums of first attention matrix:\", As[0].sum(axis=1))"
      ],
