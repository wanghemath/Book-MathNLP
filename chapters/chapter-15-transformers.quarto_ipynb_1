        "    var existing = document.querySelector('script[data-local-plotly=\"true\"]');\n",
        "    if(existing){\n",
        "      existing.addEventListener('load', callback);\n",
        "      existing.addEventListener('error', function(){ status('Local Plotly could not be loaded from assets/plotly.min.js.', true); });\n",
