      "source": [
        "#| label: py-ch15-layernorm\n",
        "#| echo: true\n",
        "import numpy as np\n",
        "\n",
        "np.set_printoptions(precision=4, suppress=True)\n",
        "\n",
        "def layer_norm(X, gamma=None, beta=None, eps=1e-5):\n",
        "    \"\"\"Layer normalization for X with shape (T, d).\"\"\"\n",
        "    X = np.asarray(X, dtype=float)\n",
        "    mu = X.mean(axis=1, keepdims=True)\n",
        "    var = ((X - mu) ** 2).mean(axis=1, keepdims=True)\n",
        "    Z = (X - mu) / np.sqrt(var + eps)\n",
        "    if gamma is None:\n",
        "        gamma = np.ones(X.shape[1])\n",
        "    if beta is None:\n",
        "        beta = np.zeros(X.shape[1])\n",
        "    return Z * gamma + beta\n",
        "\n",
        "X = np.array([\n",
        "    [2.0, 4.0, 6.0, 8.0],\n",
        "    [1.0, 1.0, 3.0, 7.0],\n",
        "    [-2.0, 0.0, 2.0, 4.0]\n",
        "])\n",
        "\n",
        "Y = layer_norm(X)\n",
        "print(Y)\n",
        "print(\"row means after LN:\", Y.mean(axis=1))\n",
        "print(\"row variances after LN:\", Y.var(axis=1))"
