        "    s.onerror = function(){ status('Local Plotly could not be loaded from ../assets/plotly.min.js. Check that assets/plotly.min.js is included in the rendered book.', true); };\n",
        "    document.head.appendChild(s);\n",
        "  }\n",
        "  function softmax(row){\n",
        "    var m = Math.max.apply(null, row);\n",
        "    var ex = row.map(function(v){ return Math.exp(v - m); });\n",
        "    var s = ex.reduce(function(a,b){ return a+b; }, 0);\n",
        "    return ex.map(function(v){ return v/s; });\n",
        "  }\n",
        "  function matmul(A,B){\n",
        "    var out = [];\n",
        "    for(var i=0;i<A.length;i++){\n",
        "      var row = [];\n",
        "      for(var j=0;j<B[0].length;j++){\n",
        "        var acc = 0;\n",
        "        for(var k=0;k<B.length;k++) acc += A[i][k]*B[k][j];\n",
