        "def sample_next(distribution):\n",
        "    words = list(distribution.keys())\n",
        "    probs = list(distribution.values())\n",
        "    return random.choices(words, weights=probs, k=1)[0]\n",
        "\n",
        "def generate_ngram(n, vocab, context_counts, next_counts, alpha=0.5, max_steps=20, seed=7):\n",
        "    random.seed(seed)\n",
        "    context = tuple([\"<s>\"] * (n - 1))\n",
        "    generated = []\n",
        "\n",
        "    for _ in range(max_steps):\n",
        "        dist = next_token_distribution(context, vocab, context_counts, next_counts, alpha=alpha)\n",
        "        word = sample_next(dist)\n",
        "        if word == \"</s>\":\n",
        "            break\n",
        "        generated.append(word)\n",
        "        if n > 1:\n",
        "            context = tuple((list(context) + [word])[-(n - 1):])\n",
        "\n",
        "    return \" \".join(generated)\n",
        "\n",
