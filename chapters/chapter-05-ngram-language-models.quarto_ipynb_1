    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from collections import Counter, defaultdict\n",
        "import math\n",
        "import random\n",
        "\n",
        "corpus = [\n",
        "    \"language models learn from data\",\n",
        "    \"language models predict tokens\",\n",
        "    \"statistical models learn probability\",\n",
        "    \"neural models learn representations\",\n",
        "    \"data science uses probability models\",\n",
        "    \"models predict language tokens\",\n",
        "]\n",
        "\n",
        "def tokenize(sentence):\n",
        "    return sentence.lower().split()\n",
        "\n",
        "def add_boundaries(tokens, n):\n",
        "    return [\"<s>\"] * (n - 1) + tokens + [\"</s>\"]\n",
        "\n",
        "def fit_ngram(corpus, n=2):\n",
        "    context_counts = Counter()\n",
        "    next_counts = defaultdict(Counter)\n",
        "    vocab = set([\"<s>\", \"</s>\"])\n",
        "\n",
        "    for sentence in corpus:\n",
        "        tokens = add_boundaries(tokenize(sentence), n)\n",
        "        vocab.update(tokens)\n",
        "        for i in range(n - 1, len(tokens)):\n",
        "            context = tuple(tokens[i - n + 1:i])\n",
        "            word = tokens[i]\n",
        "            context_counts[context] += 1\n",
        "            next_counts[context][word] += 1\n",
        "\n",
        "    vocab = sorted(vocab)\n",
        "    return vocab, context_counts, next_counts\n",
        "\n",
        "vocab, context_counts, next_counts = fit_ngram(corpus, n=2)\n",
        "context = (\"models\",)\n",
        "\n",
        "print(\"Vocabulary:\", vocab)\n",
        "print(\"Context count:\", context_counts[context])\n",
        "print(\"Next-token counts after 'models':\", next_counts[context])\n",
        "\n",
        "print(\"\\nMLE next-token probabilities:\")\n",
        "for word, count in next_counts[context].most_common():\n",
        "    prob = count / context_counts[context]\n",
        "    print(f\"P({word:16s} | models) = {prob:.3f}\")"
