        "import re\n",
        "from collections import Counter, defaultdict\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "train_docs = [\n",
        "    (\"free money win now\", \"spam\"),\n",
        "    (\"win a free prize\", \"spam\"),\n",
        "    (\"cheap offer free entry\", \"spam\"),\n",
        "    (\"meeting schedule for project\", \"ham\"),\n",
        "    (\"project meeting tomorrow\", \"ham\"),\n",
        "    (\"please review the project schedule\", \"ham\"),\n",
        "]\n",
        "\n",
        "test_docs = [\n",
        "    \"free project prize\",\n",
        "    \"meeting tomorrow schedule\",\n",
        "    \"win free offer\",\n",
        "    \"please review money\",\n",
        "]\n",
        "\n",
