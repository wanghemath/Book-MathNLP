        "spread = [0.25, 0.25, 0.25, 0.25]\n",
        "\n",
        "print(\"Entropy of sharp distribution:\", round(entropy(sharp), 4))\n",
        "print(\"Entropy of spread distribution:\", round(entropy(spread), 4))"
