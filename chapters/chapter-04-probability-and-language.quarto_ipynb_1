      "source": [
        "observed_tokens = [\"data\", \"models\", \"learn\", \"data\"]\n",
        "model_p = {\n",
        "    \"data\": 0.40,\n",
        "    \"models\": 0.25,\n",
        "    \"learn\": 0.20,\n",
        "    \"language\": 0.15\n",
        "}\n",
        "\n",
        "nll = -sum(math.log(model_p[token]) for token in observed_tokens)\n",
        "avg_nll = nll / len(observed_tokens)\n",
        "\n",
        "print(\"Negative log-likelihood:\", round(nll, 4))\n",
        "print(\"Average negative log-likelihood:\", round(avg_nll, 4))\n",
        "print(\"Perplexity:\", round(math.exp(avg_nll), 4))"
