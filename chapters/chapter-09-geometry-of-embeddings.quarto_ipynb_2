    "#| label: py-ch09-nearest-neighbors\n",
    "import numpy as np\n",
    "\n",
    "words = [\"cat\", \"dog\", \"lion\", \"car\", \"truck\", \"bus\", \"king\", \"queen\"]\n",
    "X = np.array([\n",
    "    [1.00,  0.90],\n",
    "    [1.10,  0.80],\n",
    "    [1.45,  1.10],\n",
    "    [-1.00, -0.80],\n",
    "    [-1.25, -0.90],\n",
    "    [-0.90, -1.15],\n",
    "    [0.20,  1.85],\n",
    "    [0.05,  1.70],\n",
    "])\n",
    "\n",
    "def cosine_scores(X, q):\n",
    "    X_norm = X / np.linalg.norm(X, axis=1, keepdims=True)\n",
    "    q_norm = q / np.linalg.norm(q)\n",
    "    return X_norm @ q_norm\n",
    "\n",
    "def euclidean_distances(X, q):\n",
    "    return np.linalg.norm(X - q, axis=1)\n",
    "\n",
    "def nearest_neighbors(query_word, metric=\"cosine\", k=3):\n",
    "    idx = words.index(query_word)\n",
    "    q = X[idx]\n",
    "\n",
    "    if metric == \"cosine\":\n",
    "        values = cosine_scores(X, q)\n",
    "        order = np.argsort(-values)\n",
    "    elif metric == \"inner\":\n",
    "        values = X @ q\n",
    "        order = np.argsort(-values)\n",
    "    elif metric == \"euclidean\":\n",
    "        values = euclidean_distances(X, q)\n",
    "        order = np.argsort(values)\n",
    "    else:\n",
    "        raise ValueError(\"metric must be cosine, inner, or euclidean\")\n",
    "\n",
    "    result = []\n",
    "    for j in order:\n",
    "        if j != idx:\n",
    "            result.append((words[j], float(values[j])))\n",
    "        if len(result) == k:\n",
    "            break\n",
    "    return result\n",
    "\n",
    "print(\"cosine:\", nearest_neighbors(\"cat\", metric=\"cosine\"))\n",
    "print(\"inner product:\", nearest_neighbors(\"cat\", metric=\"inner\"))\n",
    "print(\"euclidean:\", nearest_neighbors(\"cat\", metric=\"euclidean\"))"
   ]
