        "\n",
        "def mutual_information_from_table(table):\n",
        "    table = np.asarray(table, dtype=float)\n",
        "    pxy = table / table.sum()\n",
        "    px = pxy.sum(axis=1, keepdims=True)\n",
        "    py = pxy.sum(axis=0, keepdims=True)\n",
        "    expected = px @ py\n",
