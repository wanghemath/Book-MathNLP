      "source": [
        "def ppmi_matrix(C, eps=1e-12):\n",
        "    total = C.sum()\n",
        "    row_sum = C.sum(axis=1, keepdims=True)\n",
        "    col_sum = C.sum(axis=0, keepdims=True)\n",
        "    expected = row_sum @ col_sum / max(total, eps)\n",
        "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
        "        pmi = np.log((C * total + eps) / (row_sum @ col_sum + eps))\n",
        "    pmi[C == 0] = 0.0\n",
        "    return np.maximum(pmi, 0.0)\n",
        "\n",
        "M = ppmi_matrix(C)\n",
        "M_df = pd.DataFrame(M, index=vocab, columns=vocab)\n",
        "M_df.round(2).iloc[:8, :8]"
      ],
      "id": "1584b84d",
      "execution_count": null,
      "outputs": []
