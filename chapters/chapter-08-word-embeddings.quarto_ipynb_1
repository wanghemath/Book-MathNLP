    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## SVD embeddings from PPMI\n",
        "\n",
        "We factor the PPMI matrix and keep the first $m$ singular directions."
      ],
      "id": "0fd58810"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def svd_embeddings(M, m=2):\n",
        "    U, s, Vt = np.linalg.svd(M, full_matrices=False)\n",
        "    E = U[:, :m] * np.sqrt(s[:m])\n",
        "    F = Vt[:m, :].T * np.sqrt(s[:m])\n",
        "    return E, F, s\n",
        "\n",
        "E2, F2, singular_values = svd_embeddings(M, m=2)\n",
        "emb_df = pd.DataFrame(E2, index=vocab, columns=[\"z1\", \"z2\"])\n",
        "emb_df.head()"
      ],
