        "import re\n",
        "from collections import Counter, defaultdict\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "corpus = [\n",
        "    \"linear algebra studies vectors matrices and spaces\",\n",
        "    \"singular value decomposition finds low dimensional structure\",\n",
        "    \"probability models uncertainty in language data\",\n",
        "    \"language models predict words from context\",\n",
        "    \"word embeddings represent words as vectors\",\n",
        "    \"vectors and matrices are central to machine learning\",\n",
        "    \"context helps determine the meaning of words\",\n",
        "    \"statistics and probability help evaluate language models\",\n",
        "    \"machine learning learns representations from data\",\n",
        "    \"embeddings place related words near each other\"\n",
        "]\n",
        "\n",
        "def tokenize(text):\n",
        "    return re.findall(r\"[a-z]+\", text.lower())\n",
        "\n",
        "tokenized = [tokenize(doc) for doc in corpus]\n",
        "tokenized[:2]"
