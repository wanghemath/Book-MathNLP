    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Nearest neighbors"
      ],
      "id": "c74601c1"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def row_normalize(X, eps=1e-12):\n",
        "    norms = np.linalg.norm(X, axis=1, keepdims=True)\n",
        "    return X / np.maximum(norms, eps)\n",
        "\n",
        "def nearest_neighbors(word, E, k=5):\n",
        "    idx = word_to_id[word]\n",
        "    En = row_normalize(E)\n",
        "    scores = En @ En[idx]\n",
        "    order = np.argsort(-scores)\n",
        "    rows = []\n",
        "    for j in order:\n",
        "        if j != idx:\n",
        "            rows.append((id_to_word[j], float(scores[j])))\n",
        "        if len(rows) == k:\n",
        "            break\n",
        "    return pd.DataFrame(rows, columns=[\"word\", \"cosine_similarity\"])\n",
        "\n",
        "nearest_neighbors(\"language\", E2, k=6)"
      ],
      "id": "57cebec9",
      "execution_count": null,
      "outputs": []
    },
