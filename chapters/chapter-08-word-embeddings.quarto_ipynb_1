      "source": [
        "def cooccurrence_matrix(pairs, d):\n",
        "    C = np.zeros((d, d), dtype=float)\n",
        "    for i, j in pairs:\n",
        "        C[i, j] += 1.0\n",
        "    return C\n",
        "\n",
        "C = cooccurrence_matrix(pairs, len(vocab))\n",
        "C_df = pd.DataFrame(C, index=vocab, columns=vocab)\n",
