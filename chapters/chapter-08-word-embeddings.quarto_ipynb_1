        "## Word-context pairs\n",
        "\n",
        "The following function constructs center-context pairs using a symmetric window of radius $h$."
      ],
      "id": "f0d70a05"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def make_pairs(tokenized_docs, window=2):\n",
        "    pairs = []\n",
        "    for doc in tokenized_docs:\n",
        "        ids = [word_to_id[w] for w in doc]\n",
        "        for t, center in enumerate(ids):\n",
        "            left = max(0, t - window)\n",
        "            right = min(len(ids), t + window + 1)\n",
        "            for s in range(left, right):\n",
        "                if s != t:\n",
        "                    pairs.append((center, ids[s]))\n",
        "    return pairs\n",
        "\n",
        "pairs = make_pairs(tokenized, window=2)\n",
        "print(\"number of word-context pairs:\", len(pairs))\n",
        "print([(id_to_word[i], id_to_word[j]) for i, j in pairs[:12]])"
      ],
