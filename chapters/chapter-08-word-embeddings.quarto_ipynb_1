        "\n",
        "## A tiny skip-gram softmax calculation\n",
        "\n",
        "The next code implements the skip-gram probability for one center word."
      ],
      "id": "f0a531e3"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "rng = np.random.default_rng(7243)\n",
        "d = len(vocab)\n",
        "m = 4\n",
        "\n",
        "V_in = rng.normal(0, 0.1, size=(d, m))\n",
        "U_out = rng.normal(0, 0.1, size=(d, m))\n",
        "\n",
        "def softmax(z):\n",
        "    z = z - np.max(z)\n",
        "    ez = np.exp(z)\n",
        "    return ez / ez.sum()\n",
        "\n",
        "def skipgram_probs(center_word):\n",
        "    i = word_to_id[center_word]\n",
        "    scores = U_out @ V_in[i]\n",
        "    probs = softmax(scores)\n",
        "    return pd.DataFrame({\"word\": vocab, \"probability\": probs}).sort_values(\n",
        "        \"probability\", ascending=False\n",
        "    )\n",
        "\n",
        "skipgram_probs(\"language\").head(8)"
      ],
      "id": "10b45efe",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "At initialization, the probabilities are almost uniform because the random inner products are small.  Training changes the vectors so observed context words receive higher probability.\n",
        "\n",
        "## One negative-sampling update"
      ],
      "id": "30f351e4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def sigmoid(x):\n",
        "    return 1.0 / (1.0 + np.exp(-x))\n",
        "\n",
        "def negative_sampling_step(V_in, U_out, center, positive, negatives, lr=0.05):\n",
        "    i = word_to_id[center]\n",
        "    j = word_to_id[positive]\n",
        "    neg_ids = [word_to_id[w] for w in negatives]\n",
        "\n",
        "    v = V_in[i].copy()\n",
        "\n",
        "    # Positive pair gradient for -log sigmoid(u_j^T v)\n",
        "    score_pos = U_out[j] @ v\n",
        "    grad_v = (sigmoid(score_pos) - 1.0) * U_out[j]\n",
        "    grad_u_pos = (sigmoid(score_pos) - 1.0) * v\n",
        "\n",
        "    # Negative pair gradients for -log sigmoid(-u_n^T v)\n",
        "    grad_u_negs = []\n",
        "    for n in neg_ids:\n",
        "        score_neg = U_out[n] @ v\n",
        "        grad_v += sigmoid(score_neg) * U_out[n]\n",
        "        grad_u_negs.append((n, sigmoid(score_neg) * v))\n",
        "\n",
        "    V_in[i] -= lr * grad_v\n",
        "    U_out[j] -= lr * grad_u_pos\n",
        "    for n, grad_u in grad_u_negs:\n",
        "        U_out[n] -= lr * grad_u\n",
        "\n",
        "    return V_in, U_out\n",
        "\n",
        "center = \"language\"\n",
        "positive = \"models\"\n",
        "negatives = [\"algebra\", \"matrices\", \"singular\"]\n",
        "\n",
        "before = U_out[word_to_id[positive]] @ V_in[word_to_id[center]]\n",
        "V_in, U_out = negative_sampling_step(V_in, U_out, center, positive, negatives)\n",
        "after = U_out[word_to_id[positive]] @ V_in[word_to_id[center]]\n",
        "\n",
        "print(\"positive inner product before:\", round(float(before), 4))\n",
        "print(\"positive inner product after: \", round(float(after), 4))"
      ],
      "id": "fa2f35c2",
      "execution_count": null,
      "outputs": []
    },
