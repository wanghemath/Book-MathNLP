    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def rips_edges_triangles(D, eps):\n",
        "    n = D.shape[0]\n",
        "    edges = epsilon_edges(D, eps)\n",
        "    edge_index = {edge: k for k, edge in enumerate(edges)}\n",
        "    triangles = []\n",
        "    for i in range(n):\n",
        "        for j in range(i + 1, n):\n",
        "            for k in range(j + 1, n):\n",
        "                if ((i, j) in edge_index and\n",
        "                    (i, k) in edge_index and\n",
        "                    (j, k) in edge_index):\n",
        "                    triangles.append((i, j, k))\n",
        "    return edges, edge_index, triangles\n",
        "\n",
        "def rank_matrix(A, tol=1e-10):\n",
        "    if A.size == 0:\n",
        "        return 0\n",
        "    return np.linalg.matrix_rank(A, tol=tol)\n",
        "\n",
        "def betti_0_1_rips(D, eps):\n",
        "    n = D.shape[0]\n",
        "    beta0, edges = beta0_graph(D, eps)\n",
        "    edges, edge_index, triangles = rips_edges_triangles(D, eps)\n",
        "\n",
        "    graph_cycle_rank = len(edges) - n + beta0\n",
        "\n",
        "    # Boundary matrix partial_2: C_2 -> C_1.\n",
        "    B2 = np.zeros((len(edges), len(triangles)))\n",
        "    for col, (i, j, k) in enumerate(triangles):\n",
        "        # oriented boundary: [j,k] - [i,k] + [i,j]\n",
        "        B2[edge_index[(j, k)], col] = 1\n",
        "        B2[edge_index[(i, k)], col] = -1\n",
        "        B2[edge_index[(i, j)], col] = 1\n",
        "\n",
        "    rank_b2 = rank_matrix(B2)\n",
        "    beta1 = graph_cycle_rank - rank_b2\n",
        "    return {\n",
        "        \"epsilon\": eps,\n",
        "        \"vertices\": n,\n",
        "        \"edges\": len(edges),\n",
        "        \"triangles\": len(triangles),\n",
        "        \"beta0\": beta0,\n",
        "        \"graph_cycle_rank\": graph_cycle_rank,\n",
        "        \"rank_boundary_2\": rank_b2,\n",
        "        \"beta1\": int(round(beta1)),\n",
        "    }\n",
        "\n",
        "summary = [betti_0_1_rips(D, eps) for eps in [0.4, 0.8, 1.1, 1.5]]\n",
        "pd.DataFrame(summary)"
