        "def local_dimension_scores(X, k=3):\n",
        "    D = np.sqrt(((X[:, None, :] - X[None, :, :]) ** 2).sum(axis=2))\n",
        "    scores = []\n",
        "    for i in range(X.shape[0]):\n",
        "        nn = np.argsort(D[i])[1:k+1]\n",
        "        Y = X[nn] - X[i]\n",
        "        C = (Y.T @ Y) / k\n",
        "        eigvals = np.linalg.eigvalsh(C)[::-1]\n",
        "        ratio = eigvals[0] / eigvals.sum() if eigvals.sum() > 0 else np.nan\n",
        "        scores.append({\n",
        "            \"point\": labels[i],\n",
        "            \"lambda1\": eigvals[0],\n",
        "            \"lambda2\": eigvals[1],\n",
        "            \"lambda1_fraction\": ratio,\n",
        "        })\n",
        "    return pd.DataFrame(scores)\n",
        "\n",
