        "    tryNext();\n",
        "  }\n",
        "\n",
        "  const clouds = {\n",
        "    circle: {\n",
        "      labels: [\"morning\", \"class\", \"lunch\", \"office\", \"evening\", \"reading\", \"sleep\", \"dream\"],\n",
        "      xy: [[1.00,0.00],[0.70,0.72],[-0.05,1.02],[-0.78,0.65],[-1.02,-0.05],[-0.62,-0.82],[0.15,-0.98],[0.86,-0.48]]\n",
        "    },\n",
        "    clusters: {\n",
        "      labels: [\"proof\", \"theorem\", \"lemma\", \"gradient\", \"model\", \"loss\", \"bridge\", \"noise\"],\n",
        "      xy: [[-1.20,0.30],[-0.88,0.72],[-0.62,0.12],[0.62,-0.20],[0.95,0.25],[1.25,-0.35],[0.02,0.05],[0.00,1.20]]\n",
        "    }\n",
        "  };\n",
        "\n",
        "  function dist(a, b) {\n",
        "    const dx = a[0] - b[0];\n",
        "    const dy = a[1] - b[1];\n",
        "    return Math.sqrt(dx * dx + dy * dy);\n",
        "  }\n",
        "\n",
        "  function edgesAndTriangles(points, eps) {\n",
        "    const n = points.length;\n",
        "    const edges = [];\n",
        "    const edgeIndex = {};\n",
        "    for (let i = 0; i < n; i++) {\n",
        "      for (let j = i + 1; j < n; j++) {\n",
        "        if (dist(points[i], points[j]) <= eps) {\n",
        "          edgeIndex[i + \",\" + j] = edges.length;\n",
        "          edges.push([i, j]);\n",
        "        }\n",
        "      }\n",
        "    }\n",
        "    const triangles = [];\n",
        "    for (let i = 0; i < n; i++) {\n",
        "      for (let j = i + 1; j < n; j++) {\n",
        "        for (let k = j + 1; k < n; k++) {\n",
        "          if (edgeIndex[i + \",\" + j] !== undefined && edgeIndex[i + \",\" + k] !== undefined && edgeIndex[j + \",\" + k] !== undefined) {\n",
        "            triangles.push([i, j, k]);\n",
        "          }\n",
        "        }\n",
        "      }\n",
        "    }\n",
        "    return {edges: edges, edgeIndex: edgeIndex, triangles: triangles};\n",
        "  }\n",
        "\n",
        "  function components(n, edges) {\n",
        "    const parent = Array.from({length: n}, function(_, i) { return i; });\n",
        "    function find(a) {\n",
        "      while (parent[a] !== a) {\n",
        "        parent[a] = parent[parent[a]];\n",
        "        a = parent[a];\n",
        "      }\n",
        "      return a;\n",
        "    }\n",
        "    function union(a, b) {\n",
        "      const ra = find(a);\n",
        "      const rb = find(b);\n",
        "      if (ra !== rb) parent[rb] = ra;\n",
        "    }\n",
        "    edges.forEach(function(e) { union(e[0], e[1]); });\n",
        "    const roots = new Set(parent.map(function(_, i) { return find(i); }));\n",
        "    return roots.size;\n",
        "  }\n",
        "\n",
        "  function matrixRank(mat, tol) {\n",
        "    if (mat.length === 0 || mat[0].length === 0) return 0;\n",
        "    const A = mat.map(function(row) { return row.slice(); });\n",
        "    const m = A.length;\n",
        "    const n = A[0].length;\n",
        "    let rank = 0;\n",
        "    let row = 0;\n",
        "    for (let col = 0; col < n && row < m; col++) {\n",
        "      let pivot = row;\n",
        "      for (let r = row + 1; r < m; r++) {\n",
        "        if (Math.abs(A[r][col]) > Math.abs(A[pivot][col])) pivot = r;\n",
        "      }\n",
        "      if (Math.abs(A[pivot][col]) <= tol) continue;\n",
        "      const tmp = A[row];\n",
        "      A[row] = A[pivot];\n",
        "      A[pivot] = tmp;\n",
        "      const div = A[row][col];\n",
        "      for (let c = col; c < n; c++) A[row][c] /= div;\n",
        "      for (let r = 0; r < m; r++) {\n",
        "        if (r !== row) {\n",
        "          const factor = A[r][col];\n",
        "          for (let c = col; c < n; c++) A[r][c] -= factor * A[row][c];\n",
        "        }\n",
        "      }\n",
        "      rank++;\n",
        "      row++;\n",
        "    }\n",
        "    return rank;\n",
        "  }\n",
        "\n",
        "  function betaNumbers(points, eps) {\n",
        "    const n = points.length;\n",
        "    const et = edgesAndTriangles(points, eps);\n",
        "    const c = components(n, et.edges);\n",
        "    const graphCycles = et.edges.length - n + c;\n",
        "    const B2 = Array.from({length: et.edges.length}, function() { return Array(et.triangles.length).fill(0); });\n",
