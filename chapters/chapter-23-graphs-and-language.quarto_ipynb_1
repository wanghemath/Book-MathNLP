        "\n",
        "  const nodes = [\"math\", \"statistics\", \"probability\", \"language\", \"model\", \"token\", \"graph\", \"coffee\"];\n",
        "  const xy = {\n",
        "    \"math\": [-1.8, 0.8],\n",
        "    \"statistics\": [-0.8, 1.2],\n",
        "    \"probability\": [0.1, 0.8],\n",
        "    \"language\": [0.8, 0.0],\n",
        "    \"model\": [0.0, -0.2],\n",
        "    \"token\": [1.7, 0.2],\n",
        "    \"graph\": [-0.8, -0.8],\n",
        "    \"coffee\": [1.2, -1.1]\n",
        "  };\n",
        "  const edges = [\n",
        "    [\"math\", \"statistics\", 3],\n",
        "    [\"statistics\", \"probability\", 4],\n",
        "    [\"probability\", \"model\", 3],\n",
        "    [\"model\", \"language\", 3],\n",
        "    [\"language\", \"token\", 4],\n",
        "    [\"model\", \"graph\", 2],\n",
        "    [\"graph\", \"math\", 2],\n",
        "    [\"token\", \"model\", 2],\n",
        "    [\"coffee\", \"language\", 1],\n",
        "    [\"coffee\", \"token\", 1]\n",
        "  ];\n",
        "  const initial = {\n",
        "    \"math\": 1.0,\n",
        "    \"statistics\": 0.8,\n",
        "    \"probability\": 0.6,\n",
        "    \"language\": 0.1,\n",
        "    \"model\": 0.2,\n",
        "    \"token\": 0.0,\n",
        "    \"graph\": 0.5,\n",
        "    \"coffee\": -0.8\n",
        "  };\n",
        "\n",
        "  function rowStochasticMatrix(threshold) {\n",
        "    const n = nodes.length;\n",
        "    const A = Array.from({length: n}, function() { return Array(n).fill(0); });\n",
        "    const index = Object.fromEntries(nodes.map(function(name, idx) { return [name, idx]; }));\n",
        "    edges.forEach(function(e) {\n",
        "      if (e[2] >= threshold) {\n",
        "        const i = index[e[0]];\n",
        "        const j = index[e[1]];\n",
        "        A[i][j] += e[2];\n",
        "        A[j][i] += e[2];\n",
        "      }\n",
        "    });\n",
        "    const P = Array.from({length: n}, function() { return Array(n).fill(0); });\n",
        "    for (let i = 0; i < n; i++) {\n",
        "      const d = A[i].reduce(function(a, b) { return a + b; }, 0);\n",
