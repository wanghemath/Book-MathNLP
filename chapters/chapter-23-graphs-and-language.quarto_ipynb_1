        "def row_stochastic(A):\n",
        "    row_sums = A.sum(axis=1, keepdims=True)\n",
        "    P = np.zeros_like(A, dtype=float)\n",
        "    mask = row_sums[:, 0] > 0\n",
        "    P[mask] = A[mask] / row_sums[mask]\n",
        "    P[~mask, ~mask] = 1.0\n",
        "    return P\n",
        "\n",
        "P = row_stochastic(A)\n",
