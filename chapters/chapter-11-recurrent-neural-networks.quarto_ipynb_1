      "source": [
        "#| label: ch11-rnn-language-model\n",
        "#| warning: false\n",
        "rng = np.random.default_rng(7339)\n",
        "\n",
        "corpus = [\n",
        "    \"math students learn probability\",\n",
        "    \"statistics students learn inference\",\n",
        "    \"language models learn probability\",\n",
        "    \"students study language models\"\n",
        "]\n",
        "\n",
        "tokens = sorted(set(\" \".join(corpus).split()))\n",
        "vocab = {w: i for i, w in enumerate(tokens)}\n",
        "id_to_word = {i: w for w, i in vocab.items()}\n",
        "encoded = [[vocab[w] for w in sent.split()] for sent in corpus]\n",
        "\n",
        "d = len(vocab)\n",
        "m = 6\n",
        "r = 8\n",
        "\n",
        "E_lm = rng.normal(scale=0.2, size=(d, m))\n",
        "W_h_lm = rng.normal(scale=0.25, size=(r, r))\n",
        "W_x_lm = rng.normal(scale=0.25, size=(r, m))\n",
        "b_h_lm = np.zeros(r)\n",
        "W_o_lm = rng.normal(scale=0.25, size=(d, r))\n",
        "b_o_lm = np.zeros(d)\n",
        "\n",
        "def lm_sequence_nll(seq):\n",
        "    h = np.zeros(r)\n",
        "    nll = 0.0\n",
        "    count = 0\n",
        "    for token_id in seq:\n",
        "        logits = W_o_lm @ h + b_o_lm\n",
        "        p = softmax(logits)\n",
        "        nll -= np.log(p[token_id] + 1e-12)\n",
        "        count += 1\n",
        "        e = E_lm[token_id]\n",
        "        h = np.tanh(W_h_lm @ h + W_x_lm @ e + b_h_lm)\n",
        "    return nll, count\n",
