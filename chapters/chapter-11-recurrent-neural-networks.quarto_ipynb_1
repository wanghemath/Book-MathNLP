      "source": [
        "#| label: ch11-rnn-forward\n",
        "#| warning: false\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(7243)\n",
        "\n",
        "# Tiny vocabulary and sequence\n",
        "vocab = {\"not\": 0, \"very\": 1, \"good\": 2, \"bad\": 3, \"movie\": 4}\n",
        "sequence = [\"not\", \"very\", \"good\", \"movie\"]\n",
        "x = np.array([vocab[w] for w in sequence])\n",
        "\n",
        "# Dimensions\n",
        "d = len(vocab)   # vocabulary size\n",
        "m = 4            # embedding dimension\n",
        "r = 5            # hidden dimension\n",
        "K = 2            # number of classes\n",
        "\n",
        "# Parameters\n",
        "E = rng.normal(scale=0.2, size=(d, m))\n",
        "W_h = rng.normal(scale=0.3, size=(r, r))\n",
        "W_x = rng.normal(scale=0.3, size=(r, m))\n",
        "b_h = np.zeros(r)\n",
        "W_o = rng.normal(scale=0.3, size=(K, r))\n",
        "b_o = np.zeros(K)\n",
        "\n",
        "def softmax(z):\n",
        "    z = z - np.max(z)\n",
        "    ez = np.exp(z)\n",
        "    return ez / ez.sum()\n",
        "\n",
        "def rnn_forward(x):\n",
        "    h = np.zeros(r)\n",
        "    states = []\n",
        "    for token_id in x:\n",
        "        e = E[token_id]\n",
        "        h = np.tanh(W_h @ h + W_x @ e + b_h)\n",
        "        states.append(h.copy())\n",
        "    logits = W_o @ h + b_o\n",
        "    probs = softmax(logits)\n",
        "    return probs, np.array(states)\n",
        "\n",
        "probs, states = rnn_forward(x)\n",
        "print(\"Sequence:\", sequence)\n",
        "print(\"Hidden-state matrix shape:\", states.shape)\n",
        "print(\"Class probabilities:\", probs)"
      ],
      "id": "ch11-rnn-forward",
      "execution_count": null,
      "outputs": []
    },
