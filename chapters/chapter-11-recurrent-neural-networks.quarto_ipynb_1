        "rng = np.random.default_rng(2026)\n",
        "\n",
        "r = 6\n",
        "A = rng.normal(size=(r, r))\n",
        "# Normalize A and create versions with different spectral scales.\n",
        "eig_max = max(abs(np.linalg.eigvals(A)))\n",
        "A_base = A / eig_max\n",
        "\n",
        "scales = [0.7, 0.95, 1.1]\n",
        "steps = np.arange(1, 31)\n",
        "\n",
        "norms = {}\n",
        "for scale in scales:\n",
        "    M = scale * A_base\n",
        "    values = []\n",
        "    P = np.eye(r)\n",
        "    for _ in steps:\n",
        "        P = M @ P\n",
        "        values.append(np.linalg.norm(P, ord=2))\n",
        "    norms[scale] = values\n",
        "\n",
        "for scale, values in norms.items():\n",
        "    print(\"scale\", scale, \"first norm\", round(values[0], 3), \"last norm\", round(values[-1], 3))"
