        "#| label: ch03-document-term-matrix\n",
        "#| echo: true\n",
        "#| eval: false\n",
        "\n",
        "import re\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "corpus = [\n",
        "    \"machine learning models learn from data\",\n",
        "    \"language models predict the next token\",\n",
        "    \"statistics studies data uncertainty and models\",\n",
        "    \"learning from data helps statistical models\",\n",
        "]\n",
        "\n",
        "def tokenize(text):\n",
        "    text = text.lower()\n",
        "    return re.findall(r\"[a-z]+\", text)\n",
        "\n",
        "tokenized = [tokenize(doc) for doc in corpus]\n",
        "\n",
        "# Build vocabulary in alphabetical order for reproducibility.\n",
        "vocab = sorted(set(token for doc in tokenized for token in doc))\n",
        "token_to_id = {token: j for j, token in enumerate(vocab)}\n",
        "\n",
        "X = np.zeros((len(corpus), len(vocab)), dtype=int)\n",
        "for i, doc in enumerate(tokenized):\n",
        "    for token in doc:\n",
        "        X[i, token_to_id[token]] += 1\n",
        "\n",
        "X_df = pd.DataFrame(X, columns=vocab, index=[f\"doc_{i+1}\" for i in range(len(corpus))])\n",
        "print(X_df)"
