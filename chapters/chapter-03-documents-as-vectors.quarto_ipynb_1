        "    <option value=\"machine learning statistics\">machine learning statistics</option>\n",
        "  </select>\n",
        "\n",
        "  <br><br>\n",
        "\n",
        "  <label for=\"ch03-idf-slider\"><strong>IDF strength:</strong> <span id=\"ch03-idf-value\">1.00</span></label>\n",
        "  <input id=\"ch03-idf-slider\" type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" value=\"1\" style=\"width: 100%;\">\n",
        "\n",
        "  <div id=\"ch03-score-plot\" class=\"plotly-demo\"></div>\n",
        "  <div id=\"ch03-weight-plot\" class=\"plotly-demo\"></div>\n",
        "\n",
        "  <p id=\"ch03-explanation\" style=\"font-size: 0.95rem;\"></p>\n",
        "</div>\n",
        "\n",
        "<script src=\"https://cdn.plot.ly/plotly-2.35.2.min.js\"></script>\n",
        "<script>\n",
        "(function() {\n",
        "  const docs = [\n",
        "    \"machine learning models learn from data\",\n",
        "    \"language models predict the next token\",\n",
        "    \"statistics studies data uncertainty and models\",\n",
        "    \"learning from data helps statistical models\"\n",
        "  ];\n",
        "\n",
        "  const docLabels = [\"Doc 1\", \"Doc 2\", \"Doc 3\", \"Doc 4\"];\n",
        "\n",
        "  function tokenize(text) {\n",
        "    return text.toLowerCase().match(/[a-z]+/g) || [];\n",
        "  }\n",
        "\n",
        "  const tokenizedDocs = docs.map(tokenize);\n",
        "  const vocab = Array.from(new Set(tokenizedDocs.flat())).sort();\n",
        "  const tokenToId = new Map(vocab.map((t, i) => [t, i]));\n",
        "\n",
        "  function vectorize(tokens) {\n",
        "    const vec = Array(vocab.length).fill(0);\n",
        "    tokens.forEach(t => {\n",
        "      if (tokenToId.has(t)) vec[tokenToId.get(t)] += 1;\n",
        "    });\n",
        "    return vec;\n",
        "  }\n",
        "\n",
        "  const X = tokenizedDocs.map(vectorize);\n",
        "  const n = X.length;\n",
        "  const d = vocab.length;\n",
        "\n",
        "  const df = Array(d).fill(0);\n",
        "  for (let j = 0; j < d; j++) {\n",
        "    for (let i = 0; i < n; i++) {\n",
        "      if (X[i][j] > 0) df[j] += 1;\n",
        "    }\n",
        "  }\n",
        "\n",
        "  const idf = df.map(x => Math.log((n + 1) / (x + 1)) + 1);\n",
        "\n",
        "  function norm(vec) {\n",
        "    return Math.sqrt(vec.reduce((s, x) => s + x * x, 0));\n",
        "  }\n",
        "\n",
        "  function dot(a, b) {\n",
        "    return a.reduce((s, x, i) => s + x * b[i], 0);\n",
        "  }\n",
        "\n",
        "  function tfidf(vec, alpha) {\n",
        "    const length = vec.reduce((s, x) => s + x, 0);\n",
        "    if (length === 0) return vec.map(() => 0);\n",
        "    return vec.map((x, j) => (x / length) * Math.pow(idf[j], alpha));\n",
        "  }\n",
        "\n",
        "  function cosine(a, b) {\n",
        "    const na = norm(a);\n",
        "    const nb = norm(b);\n",
        "    if (na === 0 || nb === 0) return 0;\n",
        "    return dot(a, b) / (na * nb);\n",
        "  }\n",
        "\n",
        "  function update() {\n",
