        "    const alpha = parseFloat(document.getElementById(\"ch03-idf-slider\").value);\n",
        "    document.getElementById(\"ch03-idf-value\").textContent = alpha.toFixed(2);\n",
        "\n",
        "    const qCounts = vectorize(tokenize(queryText));\n",
        "    const qWeight = tfidf(qCounts, alpha);\n",
        "    const W = X.map(row => tfidf(row, alpha));\n",
        "    const scores = W.map(row => cosine(row, qWeight));\n",
        "\n",
        "    const scoreTrace = {\n",
        "      x: docLabels,\n",
        "      y: scores,\n",
        "      type: \"bar\",\n",
        "      text: scores.map(s => s.toFixed(3)),\n",
        "      textposition: \"auto\",\n",
        "      hovertemplate: \"%{x}<br>cosine score=%{y:.3f}<extra></extra>\"\n",
        "    };\n",
        "\n",
        "    Plotly.newPlot(\"ch03-score-plot\", [scoreTrace], {\n",
        "      title: \"Cosine similarity between query and documents\",\n",
        "      yaxis: {range: [0, 1], title: \"cosine similarity\"},\n",
        "      margin: {t: 55, l: 55, r: 20, b: 45}\n",
        "    }, {responsive: true});\n",
        "\n",
        "    const nonzeroTerms = vocab.filter((term, j) => qWeight[j] > 0);\n",
        "    const nonzeroWeights = nonzeroTerms.map(term => qWeight[tokenToId.get(term)]);\n",
        "\n",
        "    const weightTrace = {\n",
        "      x: nonzeroTerms,\n",
        "      y: nonzeroWeights,\n",
        "      type: \"bar\",\n",
        "      hovertemplate: \"%{x}<br>query weight=%{y:.3f}<extra></extra>\"\n",
        "    };\n",
        "\n",
        "    Plotly.newPlot(\"ch03-weight-plot\", [weightTrace], {\n",
        "      title: \"Weighted query vector coordinates\",\n",
        "      yaxis: {title: \"TF-IDF weight\"},\n",
        "      margin: {t: 55, l: 55, r: 20, b: 70}\n",
        "    }, {responsive: true});\n",
        "\n",
        "    const bestIndex = scores.indexOf(Math.max(...scores));\n",
        "    document.getElementById(\"ch03-explanation\").innerHTML =\n",
        "      \"Current top document: <strong>\" + docLabels[bestIndex] + \"</strong>. \" +\n",
        "      \"Its text is: <em>\" + docs[bestIndex] + \"</em>. \" +\n",
        "      \"Increasing IDF strength gives more influence to terms that appear in fewer documents.\";\n",
        "  }\n",
        "\n",
        "  document.getElementById(\"ch03-query-select\").addEventListener(\"change\", update);\n",
        "  document.getElementById(\"ch03-idf-slider\").addEventListener(\"input\", update);\n",
        "  update();\n",
        "})();\n",
        "</script>\n",
        ":::\n",
        "\n",
