        "#| label: ch03-tfidf-from-scratch\n",
        "#| echo: true\n",
        "#| eval: false\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# X is the document-term count matrix from the previous example.\n",
        "n, d = X.shape\n",
        "\n",
        "# Term frequency: length-normalized counts.\n",
        "doc_lengths = X.sum(axis=1, keepdims=True)\n",
        "TF = X / doc_lengths\n",
        "\n",
        "# Document frequency.\n",
        "df = (X > 0).sum(axis=0)\n",
        "\n",
        "# Smoothed inverse document frequency.\n",
        "idf = np.log((n + 1) / (df + 1)) + 1\n",
        "\n",
        "# TF-IDF matrix.\n",
        "W = TF * idf\n",
        "\n",
        "W_df = pd.DataFrame(W, columns=vocab, index=[f\"doc_{i+1}\" for i in range(n)])\n",
        "print(W_df.round(3))"
      ],
