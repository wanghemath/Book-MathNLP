        "#| label: ch03-cosine-search\n",
        "#| echo: true\n",
        "#| eval: false\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import re\n",
        "\n",
        "corpus = [\n",
        "    \"machine learning models learn from data\",\n",
        "    \"language models predict the next token\",\n",
        "    \"statistics studies data uncertainty and models\",\n",
        "    \"learning from data helps statistical models\",\n",
        "]\n",
        "\n",
        "def tokenize(text):\n",
        "    return re.findall(r\"[a-z]+\", text.lower())\n",
        "\n",
        "tokenized = [tokenize(doc) for doc in corpus]\n",
        "vocab = sorted(set(token for doc in tokenized for token in doc))\n",
        "token_to_id = {token: j for j, token in enumerate(vocab)}\n",
        "\n",
        "def vectorize(tokens):\n",
        "    vec = np.zeros(len(vocab))\n",
        "    for token in tokens:\n",
        "        if token in token_to_id:\n",
        "            vec[token_to_id[token]] += 1\n",
        "    return vec\n",
        "\n",
        "X = np.vstack([vectorize(doc) for doc in tokenized])\n",
        "\n",
        "query = \"data learning models\"\n",
        "q = vectorize(tokenize(query))\n",
        "\n",
        "def cosine_similarity_matrix(X, q):\n",
        "    q_norm = np.linalg.norm(q)\n",
        "    X_norms = np.linalg.norm(X, axis=1)\n",
        "    scores = X @ q\n",
        "    scores = scores / (X_norms * q_norm)\n",
        "    return scores\n",
        "\n",
        "scores = cosine_similarity_matrix(X, q)\n",
        "ranking = np.argsort(-scores)\n",
        "\n",
        "for rank, i in enumerate(ranking, start=1):\n",
        "    print(f\"{rank}. score={scores[i]:.3f} | {corpus[i]}\")"
      ],
