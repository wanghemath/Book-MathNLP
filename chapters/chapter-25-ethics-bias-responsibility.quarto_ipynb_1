        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "rng = np.random.default_rng(2025)\n",
        "\n",
        "nA = 400\n",
        "nB = 400\n",
        "YA = rng.binomial(1, 0.45, size=nA)\n",
        "YB = rng.binomial(1, 0.30, size=nB)\n",
        "\n",
        "def clipped_normal(mean, sd, size):\n",
        "    return np.clip(rng.normal(mean, sd, size=size), 0.01, 0.99)\n",
        "\n",
        "SA = np.where(YA == 1, clipped_normal(0.70, 0.14, nA), clipped_normal(0.32, 0.15, nA))\n",
