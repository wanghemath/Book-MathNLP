        "def threshold_report(df, threshold):\n",
        "    out = []\n",
        "    for g, sub in df.groupby(\"group\"):\n",
        "        y = sub[\"y\"].to_numpy()\n",
        "        yhat = (sub[\"score\"].to_numpy() >= threshold).astype(int)\n",
        "        tp = ((yhat == 1) & (y == 1)).sum()\n",
        "        fp = ((yhat == 1) & (y == 0)).sum()\n",
        "        fn = ((yhat == 0) & (y == 1)).sum()\n",
        "        tn = ((yhat == 0) & (y == 0)).sum()\n",
        "        out.append({\n",
        "            \"group\": g,\n",
        "            \"base_rate\": y.mean(),\n",
        "            \"selection_rate\": yhat.mean(),\n",
        "            \"TPR\": tp / (tp + fn),\n",
        "            \"FPR\": fp / (fp + tn),\n",
        "            \"PPV\": tp / (tp + fp) if tp + fp > 0 else np.nan,\n",
        "            \"accuracy\": (tp + tn) / len(sub)\n",
        "        })\n",
        "    return pd.DataFrame(out)\n",
        "\n",
        "threshold_report(scores, threshold=0.50)"
      ],
