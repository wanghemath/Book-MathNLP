        "        {x: histogram(rows, \"A\", 0), type: \"histogram\", opacity: 0.55, name: \"A, Y=0\", nbinsx: 20},\n",
        "        {x: histogram(rows, \"B\", 1), type: \"histogram\", opacity: 0.55, name: \"B, Y=1\", nbinsx: 20},\n",
        "        {x: histogram(rows, \"B\", 0), type: \"histogram\", opacity: 0.55, name: \"B, Y=0\", nbinsx: 20}\n",
