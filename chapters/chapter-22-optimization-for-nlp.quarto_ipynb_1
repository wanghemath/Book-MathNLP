        "import numpy as np\n",
        "\n",
        "A = np.diag([1.0, 20.0])\n",
        "\n",
        "def quad_loss(theta):\n",
        "    return 0.5 * theta @ A @ theta\n",
        "\n",
        "def quad_grad(theta):\n",
        "    return A @ theta\n",
        "\n",
        "def optimize(method=\"gd\", lr=0.08, steps=60, beta=0.9):\n",
        "    theta = np.array([2.8, 2.2], dtype=float)\n",
        "    path = [theta.copy()]\n",
        "    losses = [quad_loss(theta)]\n",
        "    m = np.zeros_like(theta)\n",
        "    v = np.zeros_like(theta)\n",
        "    beta1, beta2 = 0.9, 0.99\n",
        "    eps = 1e-8\n",
        "    for t in range(1, steps + 1):\n",
        "        g = quad_grad(theta)\n",
        "        if method == \"gd\":\n",
        "            theta = theta - lr * g\n",
        "        elif method == \"momentum\":\n",
        "            m = beta * m + g\n",
        "            theta = theta - lr * m\n",
        "        elif method == \"adam\":\n",
        "            m = beta1 * m + (1 - beta1) * g\n",
        "            v = beta2 * v + (1 - beta2) * (g * g)\n",
        "            m_hat = m / (1 - beta1 ** t)\n",
        "            v_hat = v / (1 - beta2 ** t)\n",
        "            theta = theta - lr * m_hat / (np.sqrt(v_hat) + eps)\n",
        "        path.append(theta.copy())\n",
        "        losses.append(quad_loss(theta))\n",
        "    return np.array(path), np.array(losses)\n",
        "\n",
        "for method in [\"gd\", \"momentum\", \"adam\"]:\n",
        "    path, losses = optimize(method=method)\n",
        "    print(f\"{method:8s} final theta = {np.round(path[-1], 4)}, final loss = {losses[-1]:.6f}\")"
