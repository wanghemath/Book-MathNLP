        "## 22.17 Python example: softmax regression gradient\n",
        "\n",
        "This example derives and checks the gradient for a small text classifier.  The model is\n",
        "\n",
        "$$\n",
        "z_i = W x_i + b,\n",
        "\\qquad\n",
        "p_i=\\operatorname{softmax}(z_i),\n",
        "$$\n",
        "\n",
        "with average cross-entropy loss."
      ],
      "id": "131cefbe"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(7243)\n",
        "\n",
        "X = np.array([\n",
        "    [2, 1, 0, 0],\n",
        "    [1, 2, 0, 0],\n",
        "    [0, 0, 2, 1],\n",
        "    [0, 0, 1, 2],\n",
        "    [1, 0, 1, 0],\n",
        "    [0, 1, 0, 1]\n",
        "], dtype=float)\n",
        "y = np.array([0, 0, 1, 1, 0, 1])\n",
        "K = 2\n",
        "n, d = X.shape\n",
        "\n",
        "W = rng.normal(scale=0.1, size=(K, d))\n",
        "b = np.zeros(K)\n",
        "\n",
        "def softmax_rows(Z):\n",
        "    Z_shift = Z - Z.max(axis=1, keepdims=True)\n",
        "    expZ = np.exp(Z_shift)\n",
        "    return expZ / expZ.sum(axis=1, keepdims=True)\n",
        "\n",
        "def loss_and_grad(W, b, X, y):\n",
        "    n = X.shape[0]\n",
        "    Z = X @ W.T + b\n",
        "    P = softmax_rows(Z)\n",
        "    loss = -np.mean(np.log(P[np.arange(n), y]))\n",
        "    G = P.copy()\n",
        "    G[np.arange(n), y] -= 1.0\n",
        "    G /= n\n",
        "    grad_W = G.T @ X\n",
        "    grad_b = G.sum(axis=0)\n",
        "    return loss, grad_W, grad_b\n",
        "\n",
        "loss, grad_W, grad_b = loss_and_grad(W, b, X, y)\n",
        "print(\"loss:\", round(loss, 6))\n",
        "print(\"grad_W shape:\", grad_W.shape)\n",
        "print(\"grad_b:\", np.round(grad_b, 6))"
