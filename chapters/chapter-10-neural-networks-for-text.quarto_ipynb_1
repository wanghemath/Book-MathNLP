        "## 10.14 Python example: averaged embedding classifier from scratch\n",
        "\n",
        "We now train the model\n",
        "\n",
        "$$\n",
        "h_i=\\frac{1}{T_i}\\sum_{t=1}^{T_i}E_{x_{it}},\n",
        "\\qquad\n",
        "z_i=h_iW+b,\n",
        "\\qquad\n",
        "p_i=\\operatorname{softmax}(z_i).\n",
        "$$\n",
        "\n",
        "Here $E\\in\\mathbb R^{d\\times m}$ and $W\\in\\mathbb R^{m\\times K}$."
      ],
      "id": "fe7005d6"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Model dimensions\n",
        "D = len(vocab)\n",
        "m = 6\n",
        "K = 2\n",
        "n = len(indexed)\n",
        "\n",
        "y = np.array(labels, dtype=int)\n",
        "E = 0.05 * rng.normal(size=(D, m))\n",
        "W = 0.05 * rng.normal(size=(m, K))\n",
        "b = np.zeros(K)\n",
        "\n",
        "def forward(indexed_docs, E, W, b):\n",
        "    H = np.zeros((len(indexed_docs), E.shape[1]))\n",
        "    for i, doc in enumerate(indexed_docs):\n",
        "        H[i] = E[doc].mean(axis=0)\n",
        "    Z = H @ W + b\n",
        "    P = softmax(Z)\n",
        "    return H, Z, P\n",
        "\n",
        "H, Z, P = forward(indexed, E, W, b)\n",
        "print(\"H shape:\", H.shape)\n",
        "print(\"Z shape:\", Z.shape)\n",
        "print(\"Initial loss:\", cross_entropy(P, y))"
