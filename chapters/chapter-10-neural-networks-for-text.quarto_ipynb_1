        "      mode: \"markers\",\n",
        "      type: \"scatter\",\n",
        "      name: \"class 1 examples\",\n",
        "      marker: { size: 10, symbol: \"circle\" }\n",
        "    };\n",
        "    var negative = {\n",
        "      x: [-1.8, -2.2, -1.0, -2.5, -0.8],\n",
        "      y: [1.5, 0.9, 2.1, 1.2, 0.4],\n",
        "      mode: \"markers\",\n",
        "      type: \"scatter\",\n",
        "      name: \"class 0 examples\",\n",
        "      marker: { size: 10, symbol: \"x\" }\n",
        "    };\n",
