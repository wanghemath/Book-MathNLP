      "cell_type": "code",
      "metadata": {},
      "source": [
        "lr = 1.0\n",
        "history = []\n",
        "\n",
        "for epoch in range(300):\n",
        "    H, Z, P = forward(indexed, E, W, b)\n",
        "    loss = cross_entropy(P, y)\n",
        "    history.append(loss)\n",
        "\n",
        "    # Gradient of average cross-entropy with respect to logits\n",
        "    Gz = P.copy()\n",
        "    Gz[np.arange(n), y] -= 1\n",
        "    Gz /= n\n",
        "\n",
        "    # Gradients for W and b\n",
        "    grad_W = H.T @ Gz\n",
        "    grad_b = Gz.sum(axis=0)\n",
        "\n",
        "    # Gradient with respect to averaged document representations\n",
        "    grad_H = Gz @ W.T\n",
        "\n",
        "    # Gradient for embedding matrix\n",
        "    grad_E = np.zeros_like(E)\n",
        "    for i, doc in enumerate(indexed):\n",
        "        contribution = grad_H[i] / len(doc)\n",
        "        for token_id in doc:\n",
        "            grad_E[token_id] += contribution\n",
        "\n",
        "    E -= lr * grad_E\n",
        "    W -= lr * grad_W\n",
        "    b -= lr * grad_b\n",
        "\n",
