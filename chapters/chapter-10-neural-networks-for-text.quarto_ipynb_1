        "  function sigmoid(t) { return 1 / (1 + Math.exp(-t)); }\n",
        "  function gridValues(w1, w2, b, tau) {\n",
        "    var xs = [];\n",
        "    var ys = [];\n",
        "    var z = [];\n",
        "    for (var i = 0; i <= 60; i++) xs.push(-3 + i * 0.1);\n",
