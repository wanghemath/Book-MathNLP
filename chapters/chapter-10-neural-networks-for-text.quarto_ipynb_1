      "source": [
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(7243)\n",
        "\n",
        "def softmax(Z):\n",
        "    Z_shift = Z - Z.max(axis=1, keepdims=True)\n",
        "    expZ = np.exp(Z_shift)\n",
        "    return expZ / expZ.sum(axis=1, keepdims=True)\n",
        "\n",
        "def cross_entropy(P, y):\n",
        "    n = len(y)\n",
        "    return -np.mean(np.log(P[np.arange(n), y] + 1e-12))\n",
        "\n",
        "Z = np.array([[2.0, 0.5], [0.2, 1.7]])\n",
        "P = softmax(Z)\n",
        "print(P)\n",
        "print(\"loss:\", cross_entropy(P, np.array([0, 1])))"
