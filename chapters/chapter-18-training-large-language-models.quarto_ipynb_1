        "#| label: ch18-cross-entropy\n",
        "#| echo: true\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "np.set_printoptions(precision=4, suppress=True)\n",
        "\n",
        "def softmax(logits):\n",
        "    logits = np.asarray(logits, dtype=float)\n",
        "    shifted = logits - logits.max(axis=-1, keepdims=True)\n",
        "    exp_values = np.exp(shifted)\n",
        "    return exp_values / exp_values.sum(axis=-1, keepdims=True)\n",
        "\n",
        "def cross_entropy_from_logits(logits, targets):\n",
        "    probs = softmax(logits)\n",
        "    n = len(targets)\n",
        "    losses = -np.log(probs[np.arange(n), targets])\n",
        "    return losses, losses.mean(), probs\n",
        "\n",
        "vocab = [\"math\", \"models\", \"learn\", \"data\"]\n",
        "logits = np.array([\n",
        "    [2.0, 1.0, 0.0, -1.0],\n",
        "    [0.2, 1.8, 1.1, -0.5],\n",
        "    [-0.3, 0.4, 2.2, 1.0]\n",
        "])\n",
        "targets = np.array([0, 2, 3])\n",
        "\n",
        "losses, mean_loss, probs = cross_entropy_from_logits(logits, targets)\n",
        "print(\"probabilities:\\n\", probs)\n",
        "print(\"token losses:\", losses)\n",
        "print(\"mean loss:\", mean_loss)\n",
        "print(\"perplexity:\", np.exp(mean_loss))"
