        "#| label: ch18-masked-loss\n",
        "#| echo: true\n",
        "\n",
        "# Shape: batch size 2, length 5, vocabulary size 4.\n",
        "rng = np.random.default_rng(18)\n",
        "logits_batch = rng.normal(size=(2, 5, 4))\n",
        "target_batch = np.array([\n",
        "    [0, 1, 2, 3, 0],\n",
        "    [1, 2, 0, 0, 3]\n",
        "])\n",
        "\n",
        "# Only response tokens count.\n",
        "loss_mask = np.array([\n",
        "    [0, 0, 1, 1, 1],\n",
        "    [0, 1, 1, 0, 1]\n",
        "], dtype=float)\n",
        "\n",
        "probs_batch = softmax(logits_batch)\n",
        "selected = probs_batch[\n",
        "    np.arange(2)[:, None],\n",
        "    np.arange(5)[None, :],\n",
        "    target_batch\n",
        "]\n",
        "\n",
        "token_losses = -np.log(selected)\n",
        "masked_mean = (token_losses * loss_mask).sum() / loss_mask.sum()\n",
        "\n",
        "print(\"token losses:\\n\", token_losses)\n",
        "print(\"loss mask:\\n\", loss_mask)\n",
        "print(\"masked mean loss:\", masked_mean)"
