        "#| label: ch18-logit-gradient\n",
        "#| echo: true\n",
        "\n",
        "probs = softmax(logits)\n",
        "one_hot = np.zeros_like(probs)\n",
        "one_hot[np.arange(len(targets)), targets] = 1.0\n",
        "\n",
        "grad_logits = (probs - one_hot) / len(targets)\n",
        "print(\"gradient of mean cross-entropy with respect to logits:\\n\", grad_logits)\n",
        "print(\"row sums should be zero:\", grad_logits.sum(axis=1))"
