        "## 18.19 Python example: KL penalty between current and reference models"
      ],
      "id": "572f8ff7"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: ch18-kl-penalty\n",
        "#| echo: true\n",
        "\n",
        "def kl_divergence(p, q):\n",
        "    p = np.asarray(p, dtype=float)\n",
        "    q = np.asarray(q, dtype=float)\n",
        "    return np.sum(p * (np.log(p + 1e-12) - np.log(q + 1e-12)), axis=-1)\n",
        "\n",
        "current_logits = np.array([\n",
        "    [2.2, 1.4, 0.1, -0.5],\n",
        "    [0.0, 1.2, 2.1, -0.8]\n",
        "])\n",
        "reference_logits = np.array([\n",
        "    [1.8, 1.3, 0.4, -0.1],\n",
        "    [0.2, 1.0, 1.6, -0.2]\n",
        "])\n",
        "\n",
        "p_current = softmax(current_logits)\n",
        "p_reference = softmax(reference_logits)\n",
        "kl_values = kl_divergence(p_current, p_reference)\n",
        "\n",
        "print(\"current probabilities:\\n\", p_current)\n",
        "print(\"reference probabilities:\\n\", p_reference)\n",
        "print(\"KL(current || reference):\", kl_values)\n",
        "print(\"mean KL:\", kl_values.mean())"
      ],
      "id": "ch18-kl-penalty",
      "execution_count": null,
