        "## 18.20 Python example: preference loss"
      ],
      "id": "e13ac9ef"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: ch18-preference-loss\n",
        "#| echo: true\n",
        "\n",
        "def sigmoid(x):\n",
        "    return 1.0 / (1.0 + np.exp(-x))\n",
        "\n",
        "def preference_loss(reward_chosen, reward_rejected):\n",
        "    margin = reward_chosen - reward_rejected\n",
        "    return -np.log(sigmoid(margin) + 1e-12)\n",
        "\n",
        "reward_chosen = np.array([2.0, 0.8, 1.5, 0.4])\n",
        "reward_rejected = np.array([0.5, 1.1, 0.0, 0.2])\n",
        "losses = preference_loss(reward_chosen, reward_rejected)\n",
        "\n",
        "print(\"reward margins:\", reward_chosen - reward_rejected)\n",
        "print(\"preference probabilities:\", sigmoid(reward_chosen - reward_rejected))\n",
        "print(\"preference losses:\", losses)\n",
        "print(\"mean preference loss:\", losses.mean())"
      ],
      "id": "ch18-preference-loss",
      "execution_count": null,
