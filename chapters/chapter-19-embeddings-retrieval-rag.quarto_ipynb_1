    "\n",
    "def precision_at_k(retrieved, relevant, k):\n",
    "    top = retrieved[:k]\n",
    "    return sum(item in relevant for item in top) / k\n",
    "\n",
    "def recall_at_k(retrieved, relevant, k):\n",
    "    top = retrieved[:k]\n",
    "    return sum(item in relevant for item in top) / len(relevant)\n",
    "\n",
    "def reciprocal_rank(retrieved, relevant):\n",
    "    for j, item in enumerate(retrieved, start=1):\n",
    "        if item in relevant:\n",
    "            return 1 / j\n",
    "    return 0.0\n",
    "\n",
    "def dcg_at_k(relevances, k):\n",
    "    relevances = np.asarray(relevances[:k], dtype=float)\n",
    "    discounts = np.log2(np.arange(2, k + 2))\n",
    "    return np.sum((2 ** relevances - 1) / discounts)\n",
    "\n",
