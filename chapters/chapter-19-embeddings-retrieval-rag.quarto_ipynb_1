    "#| label: ch19-toy-dense-retrieval\n",
    "#| warning: false\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "chunks = [\n",
    "    \"students may transfer graduate credits with approval\",\n",
    "    \"the course covers stochastic processes and Markov chains\",\n",
    "    \"the library has study rooms and research databases\",\n",
    "    \"machine learning uses embeddings and optimization\",\n",
    "    \"applied mathematics students study probability and linear algebra\",\n",
    "    \"transfer credit forms require the program director signature\",\n",
    "]\n",
    "\n",
    "# Coordinates are interpretable toy semantic features:\n",
    "# [administration, probability/math, ML/AI, campus resources]\n",
    "toy_embeddings = np.array([\n",
    "    [0.95, 0.10, 0.05, 0.05],\n",
    "    [0.05, 0.95, 0.05, 0.02],\n",
    "    [0.02, 0.10, 0.05, 0.95],\n",
    "    [0.05, 0.25, 0.95, 0.05],\n",
    "    [0.05, 0.90, 0.30, 0.05],\n",
    "    [0.98, 0.05, 0.05, 0.02],\n",
    "], dtype=float)\n",
    "\n",
    "queries = {\n",
    "    \"How do I transfer credits?\": np.array([1.0, 0.05, 0.05, 0.02]),\n",
    "    \"What math background helps ML?\": np.array([0.03, 0.75, 0.75, 0.03]),\n",
    "    \"Where can I study on campus?\": np.array([0.02, 0.05, 0.05, 1.0]),\n",
    "}\n",
    "\n",
    "def normalize_rows(A):\n",
    "    norms = np.linalg.norm(A, axis=1, keepdims=True)\n",
    "    return A / np.maximum(norms, 1e-12)\n",
    "\n",
    "def cosine_search(query_vec, doc_matrix, k=3):\n",
    "    Z = normalize_rows(doc_matrix)\n",
    "    q = query_vec / max(np.linalg.norm(query_vec), 1e-12)\n",
    "    scores = Z @ q\n",
    "    order = np.argsort(scores)[::-1][:k]\n",
    "    return pd.DataFrame({\n",
    "        \"rank\": np.arange(1, len(order) + 1),\n",
    "        \"chunk\": [chunks[i] for i in order],\n",
    "        \"score\": scores[order].round(3),\n",
    "    })\n",
    "\n",
    "cosine_search(queries[\"How do I transfer credits?\"], toy_embeddings, k=3)"
