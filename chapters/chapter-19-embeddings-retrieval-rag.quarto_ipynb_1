    "#| label: ch19-tfidf-retrieval\n",
    "#| warning: false\n",
    "\n",
    "import re\n",
    "from collections import Counter\n",
    "\n",
    "def tokenize(text):\n",
    "    return re.findall(r\"[a-z]+\", text.lower())\n",
    "\n",
    "vocab = sorted(set(token for c in chunks for token in tokenize(c)))\n",
    "idx = {w: j for j, w in enumerate(vocab)}\n",
    "\n",
    "X = np.zeros((len(chunks), len(vocab)))\n",
    "for i, c in enumerate(chunks):\n",
    "    counts = Counter(tokenize(c))\n",
    "    for w, count in counts.items():\n",
    "        X[i, idx[w]] = count\n",
    "\n",
    "# smoothed IDF\n",
    "n_docs = X.shape[0]\n",
    "df = (X > 0).sum(axis=0)\n",
    "idf = np.log((1 + n_docs) / (1 + df)) + 1\n",
    "X_tfidf = X * idf\n",
    "\n",
    "def vectorize_query(text):\n",
    "    q = np.zeros(len(vocab))\n",
    "    counts = Counter(tokenize(text))\n",
    "    for w, count in counts.items():\n",
    "        if w in idx:\n",
    "            q[idx[w]] = count\n",
    "    return q * idf\n",
    "\n",
    "def sparse_search(query, k=3):\n",
    "    q = vectorize_query(query)\n",
    "    Z = normalize_rows(X_tfidf)\n",
    "    q = q / max(np.linalg.norm(q), 1e-12)\n",
    "    scores = Z @ q\n",
    "    order = np.argsort(scores)[::-1][:k]\n",
    "    return pd.DataFrame({\n",
    "        \"rank\": np.arange(1, len(order) + 1),\n",
    "        \"chunk\": [chunks[i] for i in order],\n",
    "        \"score\": scores[order].round(3),\n",
    "    })\n",
    "\n",
    "sparse_search(\"transfer credit approval form\", k=3)"
   ]
