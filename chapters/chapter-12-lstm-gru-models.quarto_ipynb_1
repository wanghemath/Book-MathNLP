        "import numpy as np\n",
        "\n",
        "K = 2\n",
        "hidden_dim = h_lstm.shape[0]\n",
        "W_y = rng.normal(scale=0.3, size=(K, hidden_dim))\n",
        "b_y = np.zeros(K)\n",
