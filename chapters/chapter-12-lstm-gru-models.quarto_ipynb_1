        "#| label: ch12-gru-forward\n",
        "#| warning: false\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(7339)\n",
        "\n",
        "vocab = {\"language\": 0, \"models\": 1, \"need\": 2, \"long\": 3, \"memory\": 4}\n",
        "sequence = [\"language\", \"models\", \"need\", \"long\", \"memory\"]\n",
        "x = np.array([vocab[w] for w in sequence])\n",
        "\n",
        "# Dimensions\n",
        "d = len(vocab)\n",
        "m = 4\n",
        "r = 5\n",
        "\n",
        "E = rng.normal(scale=0.2, size=(d, m))\n",
        "\n",
        "W_z = rng.normal(scale=0.3, size=(r, m))\n",
        "U_z = rng.normal(scale=0.3, size=(r, r))\n",
        "b_z = np.zeros(r)\n",
        "\n",
        "W_r = rng.normal(scale=0.3, size=(r, m))\n",
        "U_r = rng.normal(scale=0.3, size=(r, r))\n",
        "b_r = np.zeros(r)\n",
        "\n",
        "W_h = rng.normal(scale=0.3, size=(r, m))\n",
        "U_h = rng.normal(scale=0.3, size=(r, r))\n",
        "b_h = np.zeros(r)\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "def gru_step(e_t, h_prev):\n",
        "    z_t = sigmoid(W_z @ e_t + U_z @ h_prev + b_z)\n",
        "    r_t = sigmoid(W_r @ e_t + U_r @ h_prev + b_r)\n",
        "    h_tilde = np.tanh(W_h @ e_t + U_h @ (r_t * h_prev) + b_h)\n",
        "    h_t = (1 - z_t) * h_prev + z_t * h_tilde\n",
        "    cache = {\"z\": z_t, \"r\": r_t, \"h_tilde\": h_tilde, \"h\": h_t}\n",
        "    return h_t, cache\n",
        "\n",
        "h = np.zeros(r)\n",
        "states = []\n",
        "gates = []\n",
        "for token_id in x:\n",
        "    e_t = E[token_id]\n",
        "    h, cache = gru_step(e_t, h)\n",
        "    states.append(h.copy())\n",
        "    gates.append(cache)\n",
        "\n",
        "states = np.array(states)\n",
        "print(\"Sequence:\", sequence)\n",
        "print(\"Hidden-state trajectory shape:\", states.shape)\n",
        "print(\"Final update gate:\", np.round(gates[-1][\"z\"], 3))\n",
        "print(\"Final reset gate:\", np.round(gates[-1][\"r\"], 3))"
