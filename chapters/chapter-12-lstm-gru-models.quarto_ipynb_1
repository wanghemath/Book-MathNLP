        "#| label: ch12-lstm-forward\n",
        "#| warning: false\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(7243)\n",
        "\n",
        "vocab = {\"the\": 0, \"movie\": 1, \"was\": 2, \"not\": 3, \"very\": 4, \"good\": 5}\n",
        "sequence = [\"the\", \"movie\", \"was\", \"not\", \"very\", \"good\"]\n",
        "x = np.array([vocab[w] for w in sequence])\n",
        "\n",
        "# Dimensions\n",
        "d = len(vocab)   # vocabulary size\n",
        "m = 4            # embedding dimension\n",
        "r = 5            # hidden/cell dimension\n",
        "\n",
        "# Embedding matrix\n",
        "E = rng.normal(scale=0.2, size=(d, m))\n",
        "\n",
        "# LSTM parameters\n",
        "W_f = rng.normal(scale=0.3, size=(r, m))\n",
        "U_f = rng.normal(scale=0.3, size=(r, r))\n",
        "b_f = np.ones(r) * 0.5       # positive forget bias encourages memory early in training\n",
        "\n",
        "W_i = rng.normal(scale=0.3, size=(r, m))\n",
        "U_i = rng.normal(scale=0.3, size=(r, r))\n",
        "b_i = np.zeros(r)\n",
        "\n",
        "W_o = rng.normal(scale=0.3, size=(r, m))\n",
        "U_o = rng.normal(scale=0.3, size=(r, r))\n",
        "b_o = np.zeros(r)\n",
        "\n",
        "W_c = rng.normal(scale=0.3, size=(r, m))\n",
        "U_c = rng.normal(scale=0.3, size=(r, r))\n",
        "b_c = np.zeros(r)\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "def lstm_step(e_t, h_prev, c_prev):\n",
        "    f_t = sigmoid(W_f @ e_t + U_f @ h_prev + b_f)\n",
        "    i_t = sigmoid(W_i @ e_t + U_i @ h_prev + b_i)\n",
        "    o_t = sigmoid(W_o @ e_t + U_o @ h_prev + b_o)\n",
        "    c_tilde = np.tanh(W_c @ e_t + U_c @ h_prev + b_c)\n",
        "    c_t = f_t * c_prev + i_t * c_tilde\n",
        "    h_t = o_t * np.tanh(c_t)\n",
        "    cache = {\"f\": f_t, \"i\": i_t, \"o\": o_t, \"c_tilde\": c_tilde, \"c\": c_t, \"h\": h_t}\n",
        "    return h_t, c_t, cache\n",
        "\n",
        "h = np.zeros(r)\n",
        "c = np.zeros(r)\n",
        "history = []\n",
        "\n",
        "for token_id in x:\n",
        "    e_t = E[token_id]\n",
        "    h, c, cache = lstm_step(e_t, h, c)\n",
        "    history.append(cache)\n",
        "\n",
        "print(\"Sequence:\", sequence)\n",
        "print(\"Final hidden state shape:\", h.shape)\n",
        "print(\"Final cell state shape:\", c.shape)\n",
        "print(\"Final hidden state:\", np.round(h, 3))\n",
        "print(\"Final forget gate:\", np.round(history[-1][\"f\"], 3))\n",
        "\n",
        "# Save the final LSTM states for later examples.\n",
        "h_lstm = h.copy()\n",
        "c_lstm = c.copy()"
