    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "def multi_head_self_attention(X, heads, W_O=None, mask=None):\n",
        "    outputs = []\n",
        "    attentions = []\n",
        "    for W_Q_h, W_K_h, W_V_h in heads:\n",
        "        Z_h, A_h, _ = self_attention(X, W_Q_h, W_K_h, W_V_h, mask=mask)\n",
        "        outputs.append(Z_h)\n",
        "        attentions.append(A_h)\n",
        "    Z_cat = np.concatenate(outputs, axis=1)\n",
        "    if W_O is None:\n",
        "        return Z_cat, attentions\n",
        "    return Z_cat @ W_O, attentions\n",
        "\n",
        "heads = [\n",
        "    (W_Q, W_K, W_V),\n",
        "    (\n",
        "        np.array([[0.2, 0.9], [1.0, 0.0], [0.3, 0.4]]),\n",
        "        np.array([[0.1, 0.8], [0.8, 0.2], [0.4, 0.6]]),\n",
        "        np.array([[0.5, 0.5], [1.0, 0.0], [0.0, 1.0]]),\n",
        "    ),\n",
        "]\n",
        "\n",
        "Z_multi, A_heads = multi_head_self_attention(X, heads)\n",
        "print(\"Multi-head output shape:\", Z_multi.shape)\n",
        "print(\"Head 1 attention:\")\n",
        "print(A_heads[0])\n",
