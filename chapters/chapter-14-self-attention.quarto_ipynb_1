        "import numpy as np\n",
        "\n",
        "np.set_printoptions(precision=3, suppress=True)\n",
        "\n",
        "def row_softmax(S):\n",
        "    S_shifted = S - S.max(axis=1, keepdims=True)\n",
        "    E = np.exp(S_shifted)\n",
        "    return E / E.sum(axis=1, keepdims=True)\n",
        "\n",
        "def self_attention(X, W_Q, W_K, W_V, mask=None):\n",
        "    Q = X @ W_Q\n",
        "    K = X @ W_K\n",
        "    V = X @ W_V\n",
        "    scores = Q @ K.T / np.sqrt(Q.shape[1])\n",
        "    if mask is not None:\n",
        "        scores = scores + mask\n",
        "    A = row_softmax(scores)\n",
        "    Z = A @ V\n",
        "    return Z, A, scores\n",
        "\n",
        "# Toy token matrix: T = 4 tokens, d_model = 3 features.\n",
        "X = np.array([\n",
        "    [1.0, 0.0, 0.2],\n",
        "    [0.8, 0.2, 0.1],\n",
        "    [0.1, 1.0, 0.3],\n",
        "    [0.0, 0.7, 1.0],\n",
        "])\n",
        "\n",
        "W_Q = np.array([\n",
        "    [1.0, 0.0],\n",
        "    [0.2, 0.8],\n",
        "    [0.0, 0.5],\n",
        "])\n",
        "W_K = np.array([\n",
        "    [0.9, 0.1],\n",
        "    [0.1, 0.9],\n",
        "    [0.2, 0.4],\n",
        "])\n",
        "W_V = np.array([\n",
        "    [1.0, 0.0],\n",
        "    [0.0, 1.0],\n",
        "    [0.5, 0.5],\n",
        "])\n",
        "\n",
        "Z, A, scores = self_attention(X, W_Q, W_K, W_V)\n",
        "print(\"Attention matrix A:\")\n",
        "print(A)\n",
        "print(\"\\nOutput Z:\")\n",
        "print(Z)\n",
        "print(\"\\nRow sums of A:\", A.sum(axis=1))"
