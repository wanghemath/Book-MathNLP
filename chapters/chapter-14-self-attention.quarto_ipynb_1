      "source": [
        "def entropy_rows(A):\n",
        "    A_safe = np.clip(A, 1e-12, 1.0)\n",
        "    return -(A_safe * np.log(A_safe)).sum(axis=1)\n",
        "\n",
        "print(\"Unmasked row entropies:\", entropy_rows(A))\n",
        "print(\"Causal row entropies:\", entropy_rows(A_causal))"
