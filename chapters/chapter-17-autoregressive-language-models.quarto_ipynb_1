      "source": [
        "#| label: ch17-tiny-generator\n",
        "#| echo: true\n",
        "\n",
        "rng = np.random.default_rng(2026)\n",
        "\n",
        "vocab = [\"<bos>\", \"math\", \"models\", \"learn\", \"from\", \"data\", \"language\", \"<eos>\"]\n",
        "idx = {w: i for i, w in enumerate(vocab)}\n",
        "\n",
        "# Rows are contexts, columns are next-token logits.\n",
        "Z = np.full((len(vocab), len(vocab)), -3.0)\n",
        "\n",
        "def set_logits(context, scores):\n",
        "    row = idx[context]\n",
        "    for token, score in scores.items():\n",
        "        Z[row, idx[token]] = score\n",
        "\n",
        "set_logits(\"<bos>\", {\"math\": 2.0, \"language\": 1.8, \"models\": 0.5})\n",
        "set_logits(\"math\", {\"models\": 2.5, \"learn\": 1.0, \"data\": 0.2})\n",
        "set_logits(\"language\", {\"models\": 2.4, \"data\": 0.4})\n",
        "set_logits(\"models\", {\"learn\": 2.2, \"from\": 1.4, \"<eos>\": 0.1})\n",
        "set_logits(\"learn\", {\"from\": 2.3, \"data\": 1.0})\n",
        "set_logits(\"from\", {\"data\": 2.6, \"language\": 0.4})\n",
        "set_logits(\"data\", {\"<eos>\": 2.2, \"models\": 0.4})\n",
        "set_logits(\"<eos>\", {\"<eos>\": 3.0})\n",
        "\n",
        "def next_distribution(context_token, temperature=1.0, top_k=None, top_p=None):\n",
        "    probs = softmax(Z[idx[context_token]], temperature=temperature)\n",
        "    if top_k is not None:\n",
        "        probs = top_k_filter(probs, top_k)\n",
        "    if top_p is not None:\n",
        "        probs = top_p_filter(probs, top_p)\n",
        "    return probs\n",
        "\n",
        "def generate(max_steps=10, temperature=1.0, top_k=None, top_p=None):\n",
        "    tokens = [\"<bos>\"]\n",
        "    for _ in range(max_steps):\n",
        "        probs = next_distribution(tokens[-1], temperature=temperature, top_k=top_k, top_p=top_p)\n",
        "        next_token = rng.choice(vocab, p=probs)\n",
        "        tokens.append(next_token)\n",
        "        if next_token == \"<eos>\":\n",
        "            break\n",
        "    return tokens\n",
        "\n",
        "for temp in [0.5, 1.0, 1.8]:\n",
        "    print(f\"temperature={temp}:\", \" \".join(generate(temperature=temp, top_p=0.90)))"
