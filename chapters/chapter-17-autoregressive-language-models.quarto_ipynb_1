        "#| label: ch17-softmax-perplexity\n",
        "#| echo: true\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "np.set_printoptions(precision=4, suppress=True)\n",
        "\n",
        "def softmax(logits, temperature=1.0):\n",
        "    logits = np.asarray(logits, dtype=float) / temperature\n",
        "    shifted = logits - np.max(logits)\n",
        "    exp_scores = np.exp(shifted)\n",
        "    return exp_scores / exp_scores.sum()\n",
        "\n",
        "def sequence_log_probability(next_token_probabilities):\n",
        "    probs = np.asarray(next_token_probabilities, dtype=float)\n",
        "    if np.any(probs <= 0):\n",
        "        raise ValueError(\"All observed-token probabilities must be positive.\")\n",
        "    return np.log(probs).sum()\n",
        "\n",
        "def perplexity(next_token_probabilities):\n",
        "    probs = np.asarray(next_token_probabilities, dtype=float)\n",
        "    avg_nll = -np.log(probs).mean()\n",
        "    return float(np.exp(avg_nll))\n",
        "\n",
        "observed_probs = [0.40, 0.25, 0.50, 0.20]\n",
        "logp = sequence_log_probability(observed_probs)\n",
        "ppl = perplexity(observed_probs)\n",
        "\n",
        "print(\"Sequence log-probability:\", logp)\n",
        "print(\"Perplexity:\", ppl)\n",
        "\n",
        "logits = np.array([2.0, 1.2, 0.5, -0.4])\n",
        "print(\"Softmax probabilities:\", softmax(logits))\n",
        "print(\"Temperature 0.5:\", softmax(logits, temperature=0.5))\n",
        "print(\"Temperature 2.0:\", softmax(logits, temperature=2.0))"
